<Window x:Class="VideoFixPro.WatermarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:VideoFixPro"
        Title="Watermark &amp; Brand Studio"
        Width="1260" Height="800"
        MinWidth="960" MinHeight="620"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{StaticResource BgBrush}"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Icon="Assets/app_icon.png">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarProgress"/>
    </Window.TaskbarItemInfo>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0,0,0,1" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>   <!-- Title bar -->
            <RowDefinition Height="1"/>    <!-- Separator -->
            <RowDefinition Height="*"/>    <!-- Main content -->
            <RowDefinition Height="Auto"/> <!-- Output settings & actions -->
            <RowDefinition Height="30"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ════════════════ TITLE BAR ════════════════ -->
        <Grid Grid.Row="0" Background="{StaticResource TitleBarBrush}" MouseLeftButtonDown="TitleBar_MouseDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                <Image Source="Assets/app_icon.png" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Watermark &amp; Brand Studio" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                <Border Background="#21262D" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleFileName" Text="No file loaded"
                               FontSize="10" Foreground="{StaticResource Text2Brush}" FontFamily="Segoe UI"
                               MaxWidth="400" TextTrimming="CharacterEllipsis"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="─" Style="{StaticResource TitleBarButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MinBtn_Click" ToolTip="Minimize"/>
                <Button x:Name="MaxBtn" Content="□" Style="{StaticResource TitleBarButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MaxBtn_Click" ToolTip="Maximize/Restore"/>
                <Button Content="✕" Style="{StaticResource TitleBarCloseButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseBtn_Click" ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <!-- Separator -->
        <Rectangle Grid.Row="1" Fill="{StaticResource BorderBrush}"/>

        <!-- ════════════════ MAIN CONTENT ════════════════ -->
        <Grid Grid.Row="2" Margin="14,12,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="380"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- ─────── LEFT: PREVIEW & INTERACTIVE OVERLAY ─────── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Drop Zone (before load) -->
                <Border x:Name="DropZone" Grid.Row="0" Grid.RowSpan="3"
                        BorderBrush="{StaticResource MutedBrush}" BorderThickness="2" CornerRadius="8"
                        Background="{StaticResource SurfaceBrush}" Cursor="Hand" MouseLeftButtonDown="DropZone_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1C2128"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🏷️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Watermark &amp; Brand Studio" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Drop a video file here to add logo watermarks"
                                   Foreground="{StaticResource Text2Brush}" FontFamily="Segoe UI" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Text="or click to browse  •  Live WYSIWYG overlay positioning &amp; transparency"
                                   Foreground="{StaticResource MutedBrush}" FontFamily="Segoe UI" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- File Header (after load) -->
                <Border x:Name="FileHeader" Grid.Row="0" Visibility="Collapsed"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderFileName" Foreground="{StaticResource AccentBrush}"
                                       FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxWidth="450"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Background="{StaticResource CardBrush}" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock x:Name="HeaderDuration" Text="00:00:00" Foreground="{StaticResource Text2Brush}" FontSize="11"/>
                                </Border>
                                <Border Background="{StaticResource CardBrush}" CornerRadius="3" Padding="6,2">
                                    <TextBlock x:Name="HeaderResolution" Text="1920x1080" Foreground="{StaticResource Text2Brush}" FontSize="11"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Change File" Style="{StaticResource GhostButton}" Padding="10,5" Click="ChangeFile_Click"/>
                            <Button Content="Remove" Style="{StaticResource GhostButton}" Padding="10,5" Margin="6,0,0,0" Click="RemoveFile_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Video Player Preview with Live Overlay -->
                <Border x:Name="PlayerBorder" Grid.Row="1" Background="Black" CornerRadius="8"
                        ClipToBounds="True" Visibility="Collapsed" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        SizeChanged="PlayerBorder_SizeChanged">
                    <Grid x:Name="PlayerContainer">
                        <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                      ScrubbingEnabled="True" Volume="0.5" Stretch="Uniform"
                                      MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded"/>

                        <!-- Canvas overlay that tracks exact active video aspect rectangle inside the letterbox -->
                        <Canvas x:Name="VideoFrameOverlay" HorizontalAlignment="Center" VerticalAlignment="Center"
                                ClipToBounds="True" Background="Transparent"
                                PreviewMouseLeftButtonDown="Canvas_MouseDown"
                                PreviewMouseMove="Canvas_MouseMove"
                                PreviewMouseLeftButtonUp="Canvas_MouseUp">

                            <!-- Draggable & Rotatable Watermark Host -->
                            <Grid x:Name="WatermarkDraggableHost" RenderTransformOrigin="0.5,0.5" Cursor="SizeAll"
                                  PreviewMouseLeftButtonDown="Watermark_MouseDown"
                                  PreviewMouseMove="Watermark_MouseMove"
                                  PreviewMouseLeftButtonUp="Watermark_MouseUp">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="WatermarkRotateTransform" Angle="0"/>
                                </Grid.RenderTransform>

                                <!-- Visual Selection Border when hovering or dragging -->
                                <Border x:Name="WatermarkSelectionBox" BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1.5" CornerRadius="4" Margin="-4"
                                        Background="#12388BFD" Visibility="Visible"/>

                                <!-- Live Visual Watermark Image -->
                                <Image x:Name="LiveWatermarkImage" Stretch="Uniform"
                                       Opacity="0.85" Visibility="Collapsed"/>
                            </Grid>
                        </Canvas>

                        <Button x:Name="PlayPauseBtn" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="54" Height="54" Style="{StaticResource GhostButton}" FontSize="24"
                                Content="▶" Opacity="0.75" Visibility="Collapsed" Click="TogglePlay_Click"/>
                    </Grid>
                </Border>

                <!-- Seek Bar -->
                <Grid x:Name="SeekPanel" Grid.Row="2" Margin="0,8,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SeekPlayBtn" Content="▶" Width="30" Height="26" Style="{StaticResource GhostButton}" Click="TogglePlay_Click"/>
                    <Slider x:Name="SeekSlider" Grid.Column="1" Margin="8,0" Minimum="0" Maximum="100" Value="0"
                            VerticalAlignment="Center" PreviewMouseLeftButtonDown="SeekSlider_MouseDown"
                            PreviewMouseLeftButtonUp="SeekSlider_MouseUp" ValueChanged="SeekSlider_ValueChanged"/>
                    <TextBlock x:Name="SeekTimeText" Grid.Column="2" Text="00:00 / 00:00" Foreground="{StaticResource Text2Brush}"
                               FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <!-- ─────── RIGHT: WATERMARK SETTINGS & POSITIONING ─────── -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Logo File Selection -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="🖼️ Logo Watermark File" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="13" FontFamily="Segoe UI"/>
                            
                            <Border x:Name="LogoDropBorder" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0" Cursor="Hand"
                                    MouseLeftButtonDown="SelectLogo_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" Background="#161B22" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <Image x:Name="LogoThumbnail" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                        <TextBlock x:Name="LogoFileNameText" Text="Click to select logo (PNG, JPG)"
                                                   Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Supports PNG transparency" Foreground="{StaticResource MutedBrush}" FontSize="10.5"/>
                                    </StackPanel>
                                    <Button x:Name="ClearLogoBtn" Grid.Column="2" Content="✕" Style="{StaticResource GhostButton}"
                                             Padding="8,4" Visibility="Collapsed" Click="ClearLogo_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Position & Placement Card (9-Anchor vs Free Drag) -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="📍 Position &amp; Placement" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="13" FontFamily="Segoe UI"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="ModeAnchorBtn" Content="9 Anchors" Style="{StaticResource ActiveToolButton}"
                                            Padding="8,3" FontSize="10.5" Click="ModeAnchor_Click"/>
                                    <Button x:Name="ModeFreeBtn" Content="Free Drag 🎯" Style="{StaticResource GhostButton}"
                                            Padding="8,3" FontSize="10.5" Margin="4,0,0,0" Click="ModeFree_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- 9-Position Anchor Grid Panel -->
                            <StackPanel x:Name="AnchorPanel" Margin="0,10,0,0">
                                <TextBlock Text="Choose watermark anchor location on screen:" Foreground="{StaticResource Text2Brush}" FontSize="11" Margin="0,0,0,8"/>
                                <UniformGrid Rows="3" Columns="3">
                                    <Button x:Name="PosTL" Content="Top-Left" Style="{StaticResource GhostButton}" Margin="2" Padding="0,8" Click="PosTL_Click"/>
                                    <Button x:Name="PosTC" Content="Top-Center" Style="{StaticResource GhostButton}" Margin="2" Padding="0,8" Click="PosTC_Click"/>
                                    <Button x:Name="PosTR" Content="Top-Right" Style="{StaticResource GhostButton}" Margin="2" Padding="0,8" Click="PosTR_Click"/>
                                    <Button x:Name="PosCL" Content="Center-Left" Style="{StaticResource GhostButton}" Margin="2" Padding="0,8" Click="PosCL_Click"/>
                                    <Button x:Name="PosCC" Content="Center" Style="{StaticResource GhostButton}" Margin="2" Padding="0,8" Click="PosCC_Click"/>
                                    <Button x:Name="PosCR" Content="Center-Right" Style="{StaticResource GhostButton}" Margin="2" Padding="0,8" Click="PosCR_Click"/>
                                    <Button x:Name="PosBL" Content="Bottom-Left" Style="{StaticResource GhostButton}" Margin="2" Padding="0,8" Click="PosBL_Click"/>
                                    <Button x:Name="PosBC" Content="Bottom-Center" Style="{StaticResource GhostButton}" Margin="2" Padding="0,8" Click="PosBC_Click"/>
                                    <Button x:Name="PosBR" Content="Bottom-Right" Style="{StaticResource ActiveToolButton}" Margin="2" Padding="0,8" Click="PosBR_Click"/>
                                </UniformGrid>
                            </StackPanel>

                            <!-- Free Drag / Manual Coordinate Sliders Panel -->
                            <StackPanel x:Name="FreeTransformPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                <TextBlock Text="💡 Click &amp; drag watermark directly on video or use sliders:" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,0,0,8"/>
                                <!-- X Position Slider -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="X (Pos %)" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" FontSize="11.5"/>
                                    <Slider x:Name="PosXSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="85"
                                            VerticalAlignment="Center" Margin="6,0" ValueChanged="PosXSlider_ValueChanged"/>
                                    <TextBlock x:Name="PosXText" Grid.Column="2" Text="85%" Foreground="{StaticResource TextBrush}"
                                               FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Y Position Slider -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Y (Pos %)" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" FontSize="11.5"/>
                                    <Slider x:Name="PosYSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="85"
                                            VerticalAlignment="Center" Margin="6,0" ValueChanged="PosYSlider_ValueChanged"/>
                                    <TextBlock x:Name="PosYText" Grid.Column="2" Text="85%" Foreground="{StaticResource TextBrush}"
                                               FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 🔄 Free Rotation & Angle Transform -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="🔄 Rotation &amp; Angle" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="13" FontFamily="Segoe UI"/>
                            
                            <!-- Angle Slider -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="45"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Angle" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" FontSize="11.5"/>
                                <Slider x:Name="RotateSlider" Grid.Column="1" Minimum="-180" Maximum="180" Value="0"
                                        VerticalAlignment="Center" Margin="6,0" ValueChanged="RotateSlider_ValueChanged"/>
                                <TextBlock x:Name="RotateText" Grid.Column="2" Text="0°" Foreground="{StaticResource TextBrush}"
                                           FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Quick Preset Angle Buttons -->
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="0° Reset" Style="{StaticResource GhostButton}" Margin="0,0,4,4" Padding="8,4" FontSize="10.5" Click="Rotate0_Click"/>
                                <Button Content="+45°" Style="{StaticResource GhostButton}" Margin="0,0,4,4" Padding="8,4" FontSize="10.5" Click="Rotate45_Click"/>
                                <Button Content="+90°" Style="{StaticResource GhostButton}" Margin="0,0,4,4" Padding="8,4" FontSize="10.5" Click="Rotate90_Click"/>
                                <Button Content="-45°" Style="{StaticResource GhostButton}" Margin="0,0,4,4" Padding="8,4" FontSize="10.5" Click="RotateMinus45_Click"/>
                                <Button Content="-90°" Style="{StaticResource GhostButton}" Margin="0,0,4,4" Padding="8,4" FontSize="10.5" Click="RotateMinus90_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Scale, Opacity & Margin Sliders -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="🎛️ Scaling &amp; Transparency" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="13" FontFamily="Segoe UI"/>

                            <!-- Scale Slider -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Size" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" FontSize="11.5"/>
                                <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="3" Maximum="80" Value="15"
                                        VerticalAlignment="Center" Margin="6,0" ValueChanged="ScaleSlider_ValueChanged"/>
                                <TextBlock x:Name="ScaleText" Grid.Column="2" Text="15%" Foreground="{StaticResource TextBrush}"
                                           FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Opacity Slider -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Opacity" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" FontSize="11.5"/>
                                <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="10" Maximum="100" Value="85"
                                        VerticalAlignment="Center" Margin="6,0" ValueChanged="OpacitySlider_ValueChanged"/>
                                <TextBlock x:Name="OpacityText" Grid.Column="2" Text="85%" Foreground="{StaticResource TextBrush}"
                                           FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Padding / Margin Slider (used in 9-Anchor mode) -->
                            <Grid x:Name="MarginRow" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Margin" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" FontSize="11.5"/>
                                <Slider x:Name="MarginSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="24"
                                        VerticalAlignment="Center" Margin="6,0" ValueChanged="MarginSlider_ValueChanged"/>
                                <TextBlock x:Name="MarginText" Grid.Column="2" Text="24px" Foreground="{StaticResource TextBrush}"
                                           FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <CheckBox x:Name="GpuCheck" Content="GPU Hardware Acceleration"
                                      Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"
                                      Margin="0,14,0,0" IsChecked="True" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <!-- FFmpeg Log (Collapsible) -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Watermark Engine Log" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="12" FontFamily="Segoe UI"/>
                                <Button x:Name="ToggleLogBtn" Content="Show" HorizontalAlignment="Right" Style="{StaticResource GhostButton}"
                                        Padding="8,2" FontSize="10" Click="ToggleLog_Click"/>
                            </Grid>
                            <TextBox x:Name="LogBox" Margin="0,8,0,0" Height="100" Visibility="Collapsed"
                                     Background="{StaticResource LogBgBrush}" Foreground="{StaticResource LogTextBrush}"
                                     BorderThickness="0" FontFamily="Consolas" FontSize="10.5" IsReadOnly="True"
                                     TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ════════════════ OUTPUT & ACTIONS ════════════════ -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Output" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" FontSize="12"/>
                <TextBlock x:Name="OutputPathText" Grid.Column="1" Text="Same as source file"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="2" Content="Browse" Style="{StaticResource GhostButton}" Padding="10,5" Click="BrowseOutput_Click"/>
                <Button Grid.Column="3" Content="Reset" Style="{StaticResource GhostButton}" Padding="10,5" Margin="6,0,0,0" Click="ResetOutput_Click"/>

                <!-- Progress Column -->
                <Grid x:Name="RenderProgressPanel" Grid.Column="5" VerticalAlignment="Center" Visibility="Collapsed">
                    <ProgressBar x:Name="RenderProgressBar" Height="18" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="RenderProgressText" Text="0%" Foreground="{StaticResource TextBrush}"
                               FontFamily="Consolas" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <Button x:Name="CancelBtn" Grid.Column="7" Content="Cancel" Style="{StaticResource DangerButton}"
                        Padding="16,7" Visibility="Collapsed" Click="Cancel_Click"/>
                <Button x:Name="OpenFolderBtn" Grid.Column="9" Content="Open Folder" Style="{StaticResource GhostButton}"
                        Padding="12,7" IsEnabled="False" Click="OpenFolder_Click"/>
                <Button x:Name="ApplyBtn" Grid.Column="11" Content="🏷️ Apply Watermark" Style="{StaticResource PrimaryButton}"
                        Padding="24,7" FontWeight="Bold" Click="ApplyWatermark_Click"/>
            </Grid>
        </Border>

        <!-- ════════════════ STATUS BAR ════════════════ -->
        <Grid Grid.Row="4" Background="{StaticResource TitleBarBrush}">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" Text="Ready" FontSize="11" FontFamily="Segoe UI"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Foreground="{StaticResource MutedBrush}" Text="Watermark Studio for VideoFixPro" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
