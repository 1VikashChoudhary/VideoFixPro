<Window x:Class="VideoFixPro.GifMakerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:VideoFixPro"
        Title="GIF &amp; Animated WebP Studio"
        Width="1260" Height="800"
        MinWidth="960" MinHeight="620"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{StaticResource BgBrush}"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Icon="Assets/app_icon.png">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarProgress"/>
    </Window.TaskbarItemInfo>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0,0,0,1" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>   <!-- Title bar -->
            <RowDefinition Height="1"/>    <!-- Separator -->
            <RowDefinition Height="*"/>    <!-- Main content -->
            <RowDefinition Height="Auto"/> <!-- Output settings & actions -->
            <RowDefinition Height="30"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ════════════════ TITLE BAR ════════════════ -->
        <Grid Grid.Row="0" Background="{StaticResource TitleBarBrush}" MouseLeftButtonDown="TitleBar_MouseDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                <TextBlock Text="🎞️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="GIF &amp; Animated WebP Studio" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                <Border Background="#21262D" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleFileName" Text="No file loaded"
                               FontSize="10" Foreground="{StaticResource Text2Brush}" FontFamily="Segoe UI"
                               MaxWidth="400" TextTrimming="CharacterEllipsis"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="─" Style="{StaticResource TitleBarButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MinBtn_Click" ToolTip="Minimize"/>
                <Button x:Name="MaxBtn" Content="□" Style="{StaticResource TitleBarButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MaxBtn_Click" ToolTip="Maximize/Restore"/>
                <Button Content="✕" Style="{StaticResource TitleBarCloseButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseBtn_Click" ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <!-- Separator -->
        <Rectangle Grid.Row="1" Fill="{StaticResource BorderBrush}"/>

        <!-- ════════════════ MAIN CONTENT ════════════════ -->
        <Grid Grid.Row="2" Margin="14,12,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="380"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- ─────── LEFT: PREVIEW & RANGE SELECTOR ─────── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Drop Zone (before load) -->
                <Border x:Name="DropZone" Grid.Row="0" Grid.RowSpan="4"
                        BorderBrush="{StaticResource MutedBrush}" BorderThickness="2" CornerRadius="8"
                        Background="{StaticResource SurfaceBrush}" Cursor="Hand" MouseLeftButtonDown="DropZone_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1C2128"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🎞️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="GIF &amp; Animated WebP Studio" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Drop a video file here to create crystal-clear animations"
                                   Foreground="{StaticResource Text2Brush}" FontFamily="Segoe UI" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Text="or click to browse  •  2-Pass Palette Engine for 0 Color Banding"
                                   Foreground="{StaticResource MutedBrush}" FontFamily="Segoe UI" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- File Header (after load) -->
                <Border x:Name="FileHeader" Grid.Row="0" Visibility="Collapsed"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderFileName" Foreground="{StaticResource AccentBrush}"
                                       FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxWidth="450"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Background="{StaticResource CardBrush}" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock x:Name="HeaderDuration" Text="00:00:00" Foreground="{StaticResource Text2Brush}" FontSize="11"/>
                                </Border>
                                <Border Background="{StaticResource CardBrush}" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock x:Name="HeaderResolution" Text="1920x1080" Foreground="{StaticResource Text2Brush}" FontSize="11"/>
                                </Border>
                                <Border Background="{StaticResource CardBrush}" CornerRadius="3" Padding="6,2">
                                    <TextBlock x:Name="HeaderClipDuration" Text="Clip: 5.0s" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Change File" Style="{StaticResource GhostButton}" Padding="10,5" Click="ChangeFile_Click"/>
                            <Button Content="Remove" Style="{StaticResource GhostButton}" Padding="10,5" Margin="6,0,0,0" Click="RemoveFile_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Video Player Preview -->
                <Border x:Name="PlayerBorder" Grid.Row="1" Background="Black" CornerRadius="8"
                        ClipToBounds="True" Visibility="Collapsed" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                      ScrubbingEnabled="True" Volume="0.5" Stretch="Uniform"
                                      MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded"/>
                        <Button x:Name="PlayPauseBtn" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="54" Height="54" Style="{StaticResource GhostButton}" FontSize="24"
                                Content="▶" Opacity="0.75" Visibility="Collapsed" Click="TogglePlay_Click"/>
                    </Grid>
                </Border>

                <!-- Seek Bar -->
                <Grid x:Name="SeekPanel" Grid.Row="2" Margin="0,8,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SeekPlayBtn" Content="▶" Width="30" Height="26" Style="{StaticResource GhostButton}" Click="TogglePlay_Click"/>
                    <Slider x:Name="SeekSlider" Grid.Column="1" Margin="8,0" Minimum="0" Maximum="100" Value="0"
                            VerticalAlignment="Center" PreviewMouseLeftButtonDown="SeekSlider_MouseDown"
                            PreviewMouseLeftButtonUp="SeekSlider_MouseUp" ValueChanged="SeekSlider_ValueChanged"/>
                    <TextBlock x:Name="SeekTimeText" Grid.Column="2" Text="00:00.00 / 00:00.00" Foreground="{StaticResource Text2Brush}"
                               FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                </Grid>

                <!-- Trim Range In/Out Markers -->
                <Border x:Name="TrimRangePanel" Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                        Padding="12,8" Margin="0,8,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="[ Set Start" Style="{StaticResource GhostButton}" Padding="10,5" Click="SetStart_Click"/>
                            <TextBox x:Name="StartTimeBox" Text="00:00.00" Width="80" Margin="8,0,0,0"
                                     Background="{StaticResource CardBrush}" Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                     Padding="6,4" FontFamily="Consolas" FontSize="12" TextAlignment="Center"
                                     LostFocus="StartTimeBox_LostFocus"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="▶ Play Range" Style="{StaticResource GhostButton}" Padding="12,5" Click="PlayRange_Click"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBox x:Name="EndTimeBox" Text="00:05.00" Width="80" Margin="0,0,8,0"
                                     Background="{StaticResource CardBrush}" Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                     Padding="6,4" FontFamily="Consolas" FontSize="12" TextAlignment="Center"
                                     LostFocus="EndTimeBox_LostFocus"/>
                            <Button Content="Set End ]" Style="{StaticResource GhostButton}" Padding="10,5" Click="SetEnd_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ─────── RIGHT: QUALITY & PALETTE SETTINGS ─────── -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Format & FPS -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="🎨 Format &amp; Framerate" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="13" FontFamily="Segoe UI"/>
                            
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Format" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" FontSize="11.5"/>
                                <ComboBox x:Name="FormatBox" Grid.Column="1" SelectedIndex="0">
                                    <ComboBoxItem Content="GIF (.gif) — Universal Compatibility"/>
                                    <ComboBoxItem Content="Animated WebP (.webp) — 60% Smaller File"/>
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Frame Rate" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" FontSize="11.5"/>
                                <ComboBox x:Name="FpsBox" Grid.Column="1" SelectedIndex="2">
                                    <ComboBoxItem Content="12 fps (Retro / Lightweight)"/>
                                    <ComboBoxItem Content="15 fps (Standard GIF)"/>
                                    <ComboBoxItem Content="24 fps (Smooth Cinematic)"/>
                                    <ComboBoxItem Content="30 fps (Ultra Smooth)"/>
                                    <ComboBoxItem Content="60 fps (Maximum Fluidity)"/>
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Scale Width" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" FontSize="11.5"/>
                                <ComboBox x:Name="WidthBox" Grid.Column="1" SelectedIndex="1">
                                    <ComboBoxItem Content="320px (Compact Discord/Chat)"/>
                                    <ComboBoxItem Content="480px (Standard Web Preview)"/>
                                    <ComboBoxItem Content="640px (High Quality Blog/Doc)"/>
                                    <ComboBoxItem Content="720px (HD Animation)"/>
                                    <ComboBoxItem Content="Original Video Resolution"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2-Pass Palette Engine -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="✨ 2-Pass Color Engine (0 Banding)" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="13" FontFamily="Segoe UI"/>
                            <TextBlock Text="Generates dynamic color palettes for flawless gradients:" Foreground="{StaticResource Text2Brush}" FontSize="11" Margin="0,4,0,8"/>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Dither Mode" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" FontSize="11.5"/>
                                <ComboBox x:Name="DitherBox" Grid.Column="1" SelectedIndex="0">
                                    <ComboBoxItem Content="Bayer Scale 5 (Best Smoothness &amp; Crispness)"/>
                                    <ComboBoxItem Content="Floyd-Steinberg (Classic Error Diffusion)"/>
                                    <ComboBoxItem Content="Sierra2 (Fine Texture Dither)"/>
                                    <ComboBoxItem Content="None (Sharp Pixel Colors, Smallest Size)"/>
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Looping" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" FontSize="11.5"/>
                                <ComboBox x:Name="LoopBox" Grid.Column="1" SelectedIndex="0">
                                    <ComboBoxItem Content="Infinite Loop (Forever)"/>
                                    <ComboBoxItem Content="Play Once &amp; Stop"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- FFmpeg Log (Collapsible) -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="GIF Engine Log" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="12" FontFamily="Segoe UI"/>
                                <Button x:Name="ToggleLogBtn" Content="Show" HorizontalAlignment="Right" Style="{StaticResource GhostButton}"
                                        Padding="8,2" FontSize="10" Click="ToggleLog_Click"/>
                            </Grid>
                            <TextBox x:Name="LogBox" Margin="0,8,0,0" Height="100" Visibility="Collapsed"
                                     Background="{StaticResource LogBgBrush}" Foreground="{StaticResource LogTextBrush}"
                                     BorderThickness="0" FontFamily="Consolas" FontSize="10.5" IsReadOnly="True"
                                     TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ════════════════ OUTPUT & ACTIONS ════════════════ -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Output" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" FontSize="12"/>
                <TextBlock x:Name="OutputPathText" Grid.Column="1" Text="Same as source file"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="2" Content="Browse" Style="{StaticResource GhostButton}" Padding="10,5" Click="BrowseOutput_Click"/>
                <Button Grid.Column="3" Content="Reset" Style="{StaticResource GhostButton}" Padding="10,5" Margin="6,0,0,0" Click="ResetOutput_Click"/>

                <!-- Progress Column -->
                <Grid x:Name="RenderProgressPanel" Grid.Column="5" VerticalAlignment="Center" Visibility="Collapsed">
                    <ProgressBar x:Name="RenderProgressBar" Height="18" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="RenderProgressText" Text="0%" Foreground="{StaticResource TextBrush}"
                               FontFamily="Consolas" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <Button x:Name="CancelBtn" Grid.Column="7" Content="Cancel" Style="{StaticResource DangerButton}"
                        Padding="16,7" Visibility="Collapsed" Click="Cancel_Click"/>
                <Button x:Name="OpenFolderBtn" Grid.Column="9" Content="Open Folder" Style="{StaticResource GhostButton}"
                        Padding="12,7" IsEnabled="False" Click="OpenFolder_Click"/>
                <Button x:Name="GenerateBtn" Grid.Column="11" Content="🎞️ Create Animation" Style="{StaticResource PrimaryButton}"
                        Padding="24,7" FontWeight="Bold" Click="Generate_Click"/>
            </Grid>
        </Border>

        <!-- ════════════════ STATUS BAR ════════════════ -->
        <Grid Grid.Row="4" Background="{StaticResource TitleBarBrush}">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" Text="Ready" FontSize="11" FontFamily="Segoe UI"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Foreground="{StaticResource MutedBrush}" Text="GIF &amp; WebP Studio for VideoFixPro" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
