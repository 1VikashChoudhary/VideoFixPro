<Window x:Class="VideoFixPro.AudioExtractorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:VideoFixPro.Models"
        Title="Audio Extractor"
        Width="1200"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        Background="{StaticResource BgBrush}"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        Icon="Assets/app_icon.png">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Start Extraction"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0"
                            ToolTip="Start processing the queued extraction jobs"
                            Click="StartQueue_Click"/>
                    <Button Content="Stop"
                            Style="{StaticResource DangerButton}"
                            Margin="0,0,8,0"
                            ToolTip="Stop the current extraction job"
                            Click="StopQueue_Click"/>
                    <Button Content="Add Videos..."
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,8,0"
                            ToolTip="Browse for videos to add to the queue"
                            Click="AddVideos_Click"/>
                    <Button Content="Clear Queue"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,8,0"
                            ToolTip="Clear all jobs in the queue"
                            Click="ClearQueue_Click"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Text2Brush}"
                           FontSize="12"
                           Text="Drop video files here to extract their audio tracks."/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="1. Extraction Settings"
                                   Foreground="{StaticResource TextBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="14"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Track Selection" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton x:Name="ExtractAllRadio" Content="Extract ALL audio tracks" IsChecked="True" Margin="0,0,16,0" Foreground="{StaticResource TextBrush}"/>
                                <RadioButton x:Name="ExtractFirstRadio" Content="Extract FIRST audio track only" Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Output Format" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="FormatBox" Grid.Column="1" Width="200" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Original Copy (Fastest)" IsSelected="True" ToolTip="Copy original stream without re-encoding"/>
                                <ComboBoxItem Content="MP3" ToolTip="High compatibility"/>
                                <ComboBoxItem Content="AAC" ToolTip="Good quality/size ratio"/>
                                <ComboBoxItem Content="FLAC" ToolTip="Lossless quality"/>
                                <ComboBoxItem Content="WAV" ToolTip="Uncompressed waveform"/>
                                <ComboBoxItem Content="M4A" ToolTip="Apple lossless / AAC"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Output Folder" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="OutputPathText" Grid.Column="1" Text="Same as source file" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="Browse..." Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="BrowseOutput_Click"/>
                                <Button Content="Reset" Style="{StaticResource GhostButton}" Margin="5,0,0,0" Click="ResetOutput_Click"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="2. Job Queue"
                                   Foreground="{StaticResource TextBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="14"/>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Remove Selected" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Click="RemoveSelectedJob_Click"/>
                            <Button x:Name="OpenFolderBtn" Content="Open Output Folder" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Click="OpenOutputFolder_Click"/>
                        </WrapPanel>
                        <DataGrid x:Name="JobGrid"
                                  Margin="0,4,0,0"
                                  Height="320"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  ItemsSource="{Binding}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Input Video" Binding="{Binding FileName}" Width="*"/>
                                <DataGridTextColumn Header="Progress" Binding="{Binding Progress, StringFormat={}{0:F0}%}" Width="70"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Grid.Column="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="FFmpeg Log"
                           Foreground="{StaticResource TextBrush}"
                           FontWeight="SemiBold"
                           FontSize="14"/>

                <TextBox x:Name="LogBox"
                         Grid.Row="1"
                         Margin="0,12,0,0"
                         Background="{StaticResource LogBgBrush}"
                         Foreground="{StaticResource LogTextBrush}"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="12"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"/>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Total Progress" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="MuxProgressBar" Grid.Column="1" Margin="10,0" Height="18" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="MuxProgressText" Grid.Column="2" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Text="0%"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" Text="Ready"/>
            </StackPanel>
            <TextBlock Grid.Column="1"
                       HorizontalAlignment="Right"
                       Foreground="{StaticResource MutedBrush}"
                       Text="Audio Extractor for VideoFixPro"/>
        </Grid>
    </Grid>
</Window>
