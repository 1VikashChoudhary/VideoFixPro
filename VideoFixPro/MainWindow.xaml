<Window x:Class="VideoFixPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:VideoFixPro"
        xmlns:models="clr-namespace:VideoFixPro.Models"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Video Fix Pro"
        Width="1532" Height="908"
        MinWidth="820" MinHeight="560"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{DynamicResource BgBrush}"
        AllowDrop="True"
        Icon="Assets/app_icon.png">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarProgress"/>
    </Window.TaskbarItemInfo>

    <!-- ══════════════════════ WINDOW CHROME ══════════════════════ -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0,0,0,1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Status colour converter -->
        <local:StatusColorConverter x:Key="StatusColorConverter"/>
        <local:StatusToVisibilityConverter x:Key="StatusToVisibilityConverter"/>
        <local:StatusMatchConverter x:Key="StatusMatchConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <ObjectDataProvider x:Key="RepairModeProvider" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:RepairMode"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Always on Top toggle style -->
        <Style x:Key="TitleBarToggleButton" TargetType="ToggleButton">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Foreground"   Value="{DynamicResource Text2Brush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"        Value="46"/>
            <Setter Property="Height"       Value="32"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F3152"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Content" Value="📍"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#21262D"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#2D333B"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ══════════════════════ ROOT LAYOUT ══════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>   <!-- 0: Title bar -->
            <RowDefinition Height="1"/>    <!-- 1: Separator line -->
            <RowDefinition Height="Auto"/> <!-- 2: Studio Tools Bar -->
            <RowDefinition Height="1"/>    <!-- 3: Separator line -->
            <RowDefinition Height="*"/>    <!-- 4: Main content -->
            <RowDefinition Height="Auto"/> <!-- 5: Log panel -->
            <RowDefinition Height="30"/>   <!-- 6: Status bar -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════ TITLE BAR ══════════════════════ -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBrush}"
              MouseLeftButtonDown="TitleBar_MouseDown">
            <!-- App identity -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                <Image Source="Assets/app_icon.png" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Video Fix Pro" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           FontFamily="Segoe UI" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource CardBrush}" CornerRadius="3" Padding="5,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="v1.0" FontSize="10" Foreground="{DynamicResource Text2Brush}" FontFamily="Segoe UI"/>
                </Border>
            </StackPanel>

            <!-- Window controls -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ThemeToggleBtn" Content="☀️" Style="{StaticResource TitleBarButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="ThemeToggle_Click" ToolTip="Switch Theme (Dark / Light)"/>
                <Button x:Name="AboutBtn" Content="ℹ" Style="{StaticResource TitleBarButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="AboutBtn_Click" ToolTip="About Video Fix Pro"/>
                <ToggleButton x:Name="TopmostBtn" Content="📌" Style="{StaticResource TitleBarToggleButton}"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True"
                              Click="TopmostBtn_Click" ToolTip="Always on Top"/>
                <Button x:Name="MinBtn" Content="─" Style="{StaticResource TitleBarButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MinBtn_Click" ToolTip="Minimize"/>
                <Button x:Name="MaxBtn" Content="□" Style="{StaticResource TitleBarButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MaxBtn_Click" ToolTip="Maximize/Restore"/>
                <Button Content="✕" Style="{StaticResource TitleBarCloseButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseBtn_Click" ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <!-- Separator -->
        <Rectangle Grid.Row="1" Fill="{DynamicResource BorderBrush}"/>

        <!-- ══════════════════════ STUDIO TOOLS COMMAND BAR ══════════════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" Padding="14,7">
            <Grid>
                <!-- Responsive Auto-Adjusting Tool Shelf (1 row on wide screens, 2 rows on standard/compact) -->
                <WrapPanel VerticalAlignment="Center">
                    <!-- Tool 1: Video Toolbox -->
                    <Button Style="{StaticResource StudioToolCardButton}" Click="OpenVideoToolbox_Click" Margin="0,2,8,2" Width="158"
                            ToolTip="Live interactive crop, rotation, volume, aspect ratio &amp; GPU render">
                        <Grid Margin="2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource CardBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="🧰" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Video Toolbox" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI"/>
                                    <Border Background="{DynamicResource BadgeBgBrush}" CornerRadius="3" Padding="3,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="GPU" FontSize="7.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Crop, Rotate &amp; Edit" FontSize="9" Foreground="{DynamicResource Text2Brush}" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Tool 2: Video Trimmer -->
                    <Button Style="{StaticResource StudioToolCardButton}" Click="OpenTrimTool_Click" Margin="0,2,8,2" Width="158"
                            ToolTip="Lossless video trimming, split cutting &amp; export">
                        <Grid Margin="2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource CardBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="✂️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,0,0">
                                <TextBlock Text="Video Trimmer" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI"/>
                                <TextBlock Text="Cut &amp; split segments" FontSize="9" Foreground="{DynamicResource Text2Brush}" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Tool 3: Color Grade & Visual FX -->
                    <Button Style="{StaticResource StudioToolCardButton}" Click="OpenColorGrade_Click" Margin="0,2,8,2" Width="158"
                            ToolTip="Color grading, cinematic presets, temperature &amp; visual FX">
                        <Grid Margin="2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0.5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="🎨" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,0,0">
                                <TextBlock Text="Color Grade" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI"/>
                                <TextBlock Text="Cinematic looks &amp; FX" FontSize="9" Foreground="{DynamicResource Text2Brush}" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Tool 4: Video Compressor -->
                    <Button Style="{StaticResource StudioToolCardButton}" Click="OpenCompressor_Click" Margin="0,2,8,2" Width="158"
                            ToolTip="Smart video compressor with Discord, WhatsApp &amp; custom MB presets">
                        <Grid Margin="2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource CardBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="🗜️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,0,0">
                                <TextBlock Text="Compressor" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI"/>
                                <TextBlock Text="Target size &amp; Discord" FontSize="9" Foreground="{DynamicResource Text2Brush}" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Tool 5: Video Merger -->
                    <Button Style="{StaticResource StudioToolCardButton}" Click="OpenVideoMerger_Click" Margin="0,2,8,2" Width="158"
                            ToolTip="Lossless multi-clip video merger and sequence stitcher">
                        <Grid Margin="2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource CardBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="🎬" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,0,0">
                                <TextBlock Text="Video Merger" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI"/>
                                <TextBlock Text="Stitch multiple clips" FontSize="9" Foreground="{DynamicResource Text2Brush}" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Tool 6: GIF & WebP Maker -->
                    <Button Style="{StaticResource StudioToolCardButton}" Click="OpenGifMaker_Click" Margin="0,2,8,2" Width="158"
                            ToolTip="High-quality 2-pass GIF and animated WebP studio">
                        <Grid Margin="2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource CardBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="🎞️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,0,0">
                                <TextBlock Text="GIF &amp; WebP" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI"/>
                                <TextBlock Text="2-pass palette engine" FontSize="9" Foreground="{DynamicResource Text2Brush}" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Tool 7: Speed Studio -->
                    <Button Style="{StaticResource StudioToolCardButton}" Click="OpenSpeedStudio_Click" Margin="0,2,8,2" Width="158"
                            ToolTip="0.25x Slow-motion to 16x timelapse with voice pitch correction">
                        <Grid Margin="2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource CardBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,0,0">
                                <TextBlock Text="Speed Studio" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI"/>
                                <TextBlock Text="Slow-mo &amp; timelapse" FontSize="9" Foreground="{DynamicResource Text2Brush}" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Tool 8: Watermark Studio -->
                    <Button Style="{StaticResource StudioToolCardButton}" Click="OpenWatermark_Click" Margin="0,2,8,2" Width="158"
                            ToolTip="Add transparent logo watermarks with free drag and rotation transform">
                        <Grid Margin="2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource CardBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="🏷️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,0,0">
                                <TextBlock Text="Watermark" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI"/>
                                <TextBlock Text="Logo &amp; brand overlay" FontSize="9" Foreground="{DynamicResource Text2Brush}" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Tool 9: Audio Muxer -->
                    <Button Style="{StaticResource StudioToolCardButton}" Click="OpenAudioMuxer_Click" Margin="0,2,8,2" Width="158"
                            ToolTip="Add, replace, or merge external audio tracks with video">
                        <Grid Margin="2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource CardBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="🎵" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,0,0">
                                <TextBlock Text="Audio Muxer" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI"/>
                                <TextBlock Text="Add / replace tracks" FontSize="9" Foreground="{DynamicResource Text2Brush}" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Tool 10: Extract Audio -->
                    <Button Style="{StaticResource StudioToolCardButton}" Click="OpenAudioExtractor_Click" Margin="0,2,8,2" Width="158"
                            ToolTip="Extract audio streams into MP3, AAC, WAV or FLAC">
                        <Grid Margin="2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource CardBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="🔊" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,0,0">
                                <TextBlock Text="Extract Audio" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI"/>
                                <TextBlock Text="Export MP3 / AAC" FontSize="9" Foreground="{DynamicResource Text2Brush}" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Tool 11: Privacy Shield -->
                    <Button Style="{StaticResource StudioToolCardButton}" Click="OpenMetadataCleaner_Click" Margin="0,2,8,2" Width="158"
                            ToolTip="Sanitize and purge GPS, camera serials &amp; EXIF metadata in milliseconds">
                        <Grid Margin="2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="0.5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="🛡️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,0,0">
                                <TextBlock Text="Privacy Shield" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI"/>
                                <TextBlock Text="Strip GPS &amp; EXIF tags" FontSize="9" Foreground="{DynamicResource Text2Brush}" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <!-- Tool 12: Video Stabilizer -->
                    <Button Style="{StaticResource StudioToolCardButton}" Click="OpenStabilizer_Click" Margin="0,2,8,2" Width="158"
                            ToolTip="Smooth out shaky footage using a 2-pass algorithm">
                        <Grid Margin="2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource CardBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="🎥" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Stabilizer" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI"/>
                                </StackPanel>
                                <TextBlock Text="Fix Shaky Video" FontSize="9" Foreground="{DynamicResource Text2Brush}" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Tool 13: Podcast Visualizer -->
                    <Button Style="{StaticResource StudioToolCardButton}" Click="OpenVisualizer_Click" Margin="0,2,8,2" Width="158"
                            ToolTip="Turn audio tracks into animated waveform videos">
                        <Grid Margin="2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource CardBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="🎙️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Podcast Visualizer" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI"/>
                                </StackPanel>
                                <TextBlock Text="Audio to Video" FontSize="9" Foreground="{DynamicResource Text2Brush}" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Separator -->
        <Rectangle Grid.Row="3" Fill="{DynamicResource BorderBrush}"/>

        <!-- ══════════════════════ MAIN CONTENT ══════════════════════ -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="320"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="2*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- ─────── LEFT PANEL ─────── -->
            <Grid Grid.Column="0" Margin="14,12,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Drop zone -->
                    <RowDefinition Height="Auto"/>
                    <!-- Video info -->
                    <RowDefinition Height="*"/>
                    <!-- Queue -->
                </Grid.RowDefinitions>

                <!-- ── DROP ZONE ── -->
                <Border x:Name="DropZoneBorder"
                        Grid.Row="0"
                        Height="120"
                        BorderBrush="{DynamicResource MutedBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Background="{DynamicResource SurfaceBrush}"
                        AllowDrop="True"
                        DragEnter="DropZone_DragEnter"
                        DragOver="DropZone_DragOver"
                        DragLeave="DropZone_DragLeave"
                        Drop="DropZone_Drop"
                        Cursor="Hand"
                        MouseLeftButtonDown="DropZone_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1C2128"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="DropIcon" Text="📂"
                                   FontSize="28" HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>
                        <TextBlock x:Name="DropMainText"
                                   Text="Drop video files here"
                                   Foreground="{DynamicResource Text2Brush}"
                                   FontFamily="Segoe UI" FontSize="13"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="or click to browse  •  MP4, MKV, AVI, MOV, WMV, FLV"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontFamily="Segoe UI" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ── VIDEO INFO CARD ── -->
                <Border x:Name="VideoInfoCard"
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed"
                        Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="🎬 " FontSize="12"/>
                            <TextBlock x:Name="InfoFileName" Text="video.mp4"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Row 1 -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,2">
                            <TextBlock Text="DURATION" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                            <TextBlock x:Name="InfoDuration" Text="—" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,2">
                            <TextBlock Text="SIZE" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                            <TextBlock x:Name="InfoSize" Text="—" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="12"/>
                        </StackPanel>

                        <!-- Row 2 -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,5,0,2">
                            <TextBlock Text="VIDEO CODEC" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                            <TextBlock x:Name="InfoVideoCodec" Text="—" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,5,0,2">
                            <TextBlock Text="AUDIO CODEC" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                            <TextBlock x:Name="InfoAudioCodec" Text="—" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="12"/>
                        </StackPanel>

                        <!-- Row 3 -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,5,0,0">
                            <TextBlock Text="RESOLUTION" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                            <TextBlock x:Name="InfoResolution" Text="—" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,5,0,0">
                            <TextBlock Text="BITRATE / FPS" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                            <TextBlock x:Name="InfoBitrateAndFps" Text="—" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── QUEUE SECTION ── -->
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Queue header -->
                    <Grid Grid.Row="0" Margin="0,0,0,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Queue" Foreground="{DynamicResource Text2Brush}"
                                       FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Border x:Name="QueueCountBadge"
                                    Background="{DynamicResource CardBrush}"
                                    CornerRadius="8" Padding="6,1" Margin="7,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="QueueCountText" Text="0"
                                           Foreground="{DynamicResource Text2Brush}"
                                           FontFamily="Segoe UI" FontSize="11"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="+ Folder" Style="{StaticResource GhostButton}"
                                    Padding="8,4" FontSize="11" Margin="0,0,4,0"
                                    Click="AddFolder_Click" ToolTip="Import all videos from a folder"/>
                            <Button Content="Clear Queue" Style="{StaticResource GhostButton}"
                                    Padding="8,4" FontSize="11"
                                    Click="ClearQueue_Click" ToolTip="Remove all items from queue"/>
                        </StackPanel>
                    </Grid>

                    <!-- Queue list -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <ListView x:Name="QueueList"
                                  ItemsSource="{Binding}"
                                  SelectionMode="Single"
                                  SelectionChanged="QueueList_SelectionChanged"
                                  Padding="6,4">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Thumbnail -->
                                            <Grid Grid.Column="0" Margin="0,0,12,0">
                                                <Border Width="80" Height="45" Background="{DynamicResource CardBrush}" CornerRadius="4" ClipToBounds="True">
                                                    <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>
                                                <!-- Status icon overlay -->
                                                <Border Background="#99000000" Width="20" Height="20" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5">
                                                    <TextBlock Text="{Binding StatusIcon}" Foreground="{Binding StatusColor}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>

                                            <!-- Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding FileSize}" Foreground="{DynamicResource MutedBrush}" FontSize="10"/>
                                                    <TextBlock Text=" • " Foreground="{DynamicResource MutedBrush}" FontSize="10"/>
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="10" FontWeight="Medium"/>
                                                    <TextBlock Text="{Binding ETA, StringFormat=' • ETA: {0}'}" Foreground="{DynamicResource Text2Brush}" FontSize="10">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ETA}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ETA}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Progress Bar -->
                                                <ProgressBar Value="{Binding Progress}" Height="2" Margin="0,6,0,0" Style="{StaticResource LinearProgress}" 
                                                             Foreground="{Binding StatusColor}" Background="{DynamicResource CardHoverBrush}" BorderThickness="0"
                                                             Visibility="{Binding Status, Converter={StaticResource StatusToVisibilityConverter}, ConverterParameter=Running}"/>
                                            </StackPanel>

                                            <!-- Per-job mode selector -->
                                            <ComboBox Grid.Column="2" SelectedItem="{Binding PreferredMode}" 
                                                      ItemsSource="{Binding Source={StaticResource RepairModeProvider}}"
                                                      Width="100" Height="26" VerticalAlignment="Center" Margin="10,0"
                                                      FontSize="10">
                                                <ComboBox.IsEnabled>
                                                    <MultiBinding Converter="{StaticResource StatusMatchConverter}" ConverterParameter="Waiting">
                                                        <Binding Path="Status"/>
                                                    </MultiBinding>
                                                </ComboBox.IsEnabled>
                                            </ComboBox>

                                            <!-- Remove button -->
                                            <Button Grid.Column="3" Style="{StaticResource GhostButton}" Click="RemoveJob_Click" Tag="{Binding}" 
                                                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="4" ToolTip="Remove from queue">
                                                <TextBlock Text="✕" Foreground="#F85149" FontSize="11"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>
            </Grid>

            <!-- Vertical separator -->
            <Rectangle Grid.Column="1" Fill="{DynamicResource BorderBrush}"/>

            <!-- ─────── RIGHT PANEL ─────── -->
            <Grid Grid.Column="2" Margin="10,12,14,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <!-- Scrollable Settings -->
                    <RowDefinition Height="Auto"/>
                    <!-- Action Buttons -->
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- ── REPAIR MODE ── -->
                        <Border
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Repair Mode"
                                   Foreground="{DynamicResource Text2Brush}"
                                   FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <RadioButton x:Name="ModeAuto" Content="Auto  (tries fast → deep)" IsChecked="True"
                                     ToolTip="Tries Stream Copy first; falls back to Deep Recover on failure"/>
                        <RadioButton x:Name="ModeStreamCopy" Content="Stream Copy  ·  fastest, lossless"
                                     ToolTip="Re-mux without re-encoding. Very fast but may not fix all issues."/>
                        <RadioButton x:Name="ModeReEncode" Content="Re-encode  ·  H.264 + AAC"
                                     ToolTip="Full re-encode to H.264 video and AAC audio. Fixes most issues."/>
                        <RadioButton x:Name="ModeDeepRecover" Content="Deep Recover  ·  error-tolerant"
                                     ToolTip="Enables error detection bypass and full re-encode. Slowest but most powerful."/>

                        <!-- Mode description -->
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="5"
                                Padding="10,7" Margin="0,10,0,0">
                            <TextBlock x:Name="ModeDescription"
                                       Text="Automatically selects the best strategy. Starts with a fast lossless copy; if that fails, escalates to a deep error-tolerant re-encode."
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontFamily="Segoe UI" FontSize="11"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ── OUTPUT SETTINGS ── -->
                <Border
                        Margin="0,10,0,0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Output Settings"
                                   Foreground="{DynamicResource Text2Brush}"
                                   FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <!-- Format row -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Format" Foreground="{DynamicResource Text2Brush}"
                                       FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox x:Name="FormatBox" Grid.Column="1"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="MP4"/>
                                <ComboBoxItem Content="MP4 (AV1)"/>
                                <ComboBoxItem Content="MKV"/>
                                <ComboBoxItem Content="AVI"/>
                                <ComboBoxItem Content="MOV"/>
                            </ComboBox>
                        </Grid>

                        <!-- Output path row -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Folder" Foreground="{DynamicResource Text2Brush}"
                                       FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center"/>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="5"
                                    Padding="8,5" Height="32">
                                <TextBlock x:Name="OutputFolderText"
                                           Text="Same as source file"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontFamily="Segoe UI" FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <Button Grid.Column="2" Content="Browse"
                                    Style="{StaticResource GhostButton}"
                                    Margin="6,0,0,0" Height="32" Padding="12,0"
                                    Click="BrowseOutput_Click"
                                    ToolTip="Choose output folder"/>
                            <Button x:Name="OpenFolderBtn"
                                    Grid.Column="3"
                                    Content="📂 Open"
                                    Style="{StaticResource GhostButton}"
                                    Margin="6,0,0,0" Height="32" Padding="10,0"
                                    IsEnabled="False"
                                    Click="OpenFolder_Click"
                                    ToolTip="Open the output folder in Explorer"/>
                        </Grid>

                        <!-- Reset output path -->
                        <Button Content="↩ Reset to source folder"
                                Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left"
                                Padding="0,3" BorderThickness="0"
                                FontSize="11" Margin="70,6,0,0"
                                Foreground="{DynamicResource MutedBrush}"
                                Click="ResetOutput_Click"/>

                        <!-- Quality Slider -->
                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="35"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Quality" Foreground="{DynamicResource Text2Brush}"
                                       FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center"/>
                            <Slider x:Name="QualitySlider" Grid.Column="1"
                                    Minimum="0" Maximum="100" Value="70"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center" Margin="5,0"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding ElementName=QualitySlider, Path=Value, StringFormat={}{0:F0}}"
                                           Foreground="{DynamicResource Text2Brush}"
                                           FontFamily="Segoe UI" FontSize="11" 
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="%" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="1,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="100% = Best quality, largest file. 70% is recommended."
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontFamily="Segoe UI" FontSize="9" Margin="75,2,0,0"/>

                        <!-- GPU Toggle -->
                        <CheckBox x:Name="GpuCheck" 
                                  Content="GPU Hardware Acceleration"
                                  Foreground="{DynamicResource SuccessBrush}"
                                  FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                  Margin="70,10,0,0" Cursor="Hand"
                                  Visibility="Collapsed"
                                  ToolTip="Uses Nvidia (NVENC) or AMD (AMF) for significantly faster processing"/>

                        <!-- Auto-delete toggle -->
                        <CheckBox x:Name="AutoDeleteCheck" 
                                  Content="Delete source file after success"
                                  Foreground="{DynamicResource Text2Brush}"
                                  FontFamily="Segoe UI" FontSize="11"
                                  Margin="70,10,0,0" Cursor="Hand"
                                  ToolTip="Caution: Permanently deletes the original file once repair is confirmed successful"/>
                    </StackPanel>
                </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ── ACTION BUTTONS ── -->
                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="FixAllBtn"
                            Grid.Column="0"
                            Content="⚡ Start Repair"
                            Style="{StaticResource PrimaryButton}"
                            Height="44"
                            FontSize="14"
                            FontWeight="Bold"
                            HorizontalAlignment="Stretch"
                            Click="FixAll_Click"
                            ToolTip="Start processing all video files in the queue"/>
                    <Button x:Name="CancelBtn"
                            Grid.Column="2"
                            Content="Cancel"
                            Style="{StaticResource DangerButton}"
                            IsEnabled="False"
                            Height="44"
                            FontSize="13"
                            HorizontalAlignment="Stretch"
                            Click="Cancel_Click"
                            ToolTip="Stop the current repair operation"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- ══════════════════════ LOG PANEL ══════════════════════ -->
        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="1"/>
                <!-- separator -->
                <RowDefinition Height="Auto"/>
                <!-- header -->
                <RowDefinition x:Name="LogRow" Height="160"/>
            </Grid.RowDefinitions>

            <Rectangle Grid.Row="0" Fill="{DynamicResource BorderBrush}"/>

            <!-- Log header bar -->
            <Grid Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Height="30">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <TextBlock Text="Repair Log"
                               Foreground="{DynamicResource Text2Brush}"
                               FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Content="Copy" Style="{StaticResource GhostButton}"
                            Padding="8,3" Height="22" FontSize="11"
                            Margin="0,0,4,0"
                            Click="CopyLog_Click" ToolTip="Copy log to clipboard"/>
                    <Button Content="Save" Style="{StaticResource GhostButton}"
                            Padding="8,3" Height="22" FontSize="11"
                            Margin="0,0,4,0"
                            Click="SaveLog_Click" ToolTip="Save log to a file"/>
                    <Button Content="Clear" Style="{StaticResource GhostButton}"
                            Padding="8,3" Height="22" FontSize="11"
                            Margin="0,0,4,0"
                            Click="ClearLog_Click" ToolTip="Clear the log"/>
                    <Button x:Name="ToggleLogBtn" Content="▼" Style="{StaticResource GhostButton}"
                            Padding="8,3" Height="22" FontSize="11"
                            Click="ToggleLog_Click" ToolTip="Collapse/Expand log"/>
                </StackPanel>
            </Grid>

            <!-- Log text area -->
            <TextBox x:Name="LogBox"
                     Grid.Row="2"
                     Background="{DynamicResource LogBgBrush}"
                     Foreground="{DynamicResource LogTextBrush}"
                     FontFamily="Consolas, Segoe UI"
                     FontSize="12"
                     BorderThickness="0"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Padding="12,8"/>
        </Grid>

        <!-- ══════════════════════ STATUS BAR ══════════════════════ -->
        <Grid Grid.Row="6" Background="{DynamicResource TitleBarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Status text -->
            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="14,0">
                <Ellipse x:Name="StatusDot" Width="7" Height="7"
                         Fill="{DynamicResource MutedBrush}"
                         VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           Foreground="{DynamicResource Text2Brush}"
                           FontFamily="Segoe UI" FontSize="11"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Global progress bar -->
            <ProgressBar x:Name="GlobalProgress"
                         Grid.Column="1"
                         Style="{StaticResource StatusProgress}"
                         Value="0" Minimum="0" Maximum="100"
                         Margin="0,0,14,0"
                         Visibility="Hidden"/>

            <!-- Version & Author Credit -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0" Cursor="Hand" MouseLeftButtonDown="AboutFooter_Click" ToolTip="Click to view About Video Fix Pro">
                <TextBlock Foreground="{DynamicResource MutedBrush}"
                           FontFamily="Segoe UI" FontSize="10.5"
                           VerticalAlignment="Center">
                    <Run Text="Video Fix Pro v1.0  •  Built with "/>
                    <Run Text="❤️" Foreground="#F85149"/>
                    <Run Text=" by Vikash Choudhary"/>
                </TextBlock>
            </StackPanel>
        </Grid>
        <!-- ══════════════════════ MODAL OVERLAYS ══════════════════════ -->
        <Grid x:Name="DownloadModal" Grid.RowSpan="7" Visibility="Collapsed" Panel.ZIndex="1000">
            <Rectangle Fill="#B2000000"/>
            <Border Width="420" Height="250" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Opacity="0.6" ShadowDepth="0" Color="Black"/>
                </Border.Effect>
                <Grid Margin="32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                        <Image Source="Assets/app_icon.png" Width="36" Height="36" Margin="0,0,16,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="FFmpeg Required" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{DynamicResource Text2Brush}"
                               FontSize="14" LineHeight="20">
                        Video Fix Pro requires FFmpeg binaries to process and repair your videos. Would you like to automatically download and install them now?
                    </TextBlock>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button x:Name="CancelDownloadBtn" Content="Not Now" Style="{StaticResource GhostButton}"
                                Padding="20,8" Margin="0,0,12,0" Click="CancelDownload_Click"/>
                        <Button x:Name="StartDownloadBtn" Content="Download &amp; Install" Style="{StaticResource PrimaryButton}"
                                Padding="28,8" Click="StartDownload_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════ ABOUT APP MODAL ══════════════════════ -->
        <Grid x:Name="AboutModal" Grid.RowSpan="7" Visibility="Collapsed" Panel.ZIndex="1000" MouseLeftButtonDown="AboutModalBackdrop_MouseDown">
            <Rectangle Fill="#CC000000"/>
            <Border Width="480" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="28" MouseLeftButtonDown="AboutModalCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Opacity="0.65" ShadowDepth="0" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Border Width="58" Height="58" CornerRadius="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <Image Source="Assets/app_icon.png" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="Video Fix Pro" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                        <TextBlock Text="Commercial Edition  •  Version 1.0" FontSize="11.5" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Description -->
                    <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{DynamicResource Text2Brush}" FontSize="12.5" LineHeight="19" TextAlignment="Center" Margin="8,0,8,16">
                        Video Fix Pro is a high-performance, professional media repair and processing workstation. Engineered with multi-engine recovery algorithms, multi-vendor GPU acceleration (NVIDIA NVENC, AMD AMF, Intel QSV), and 11 creative studio tools for video repair, color grading, smart compression, lossless cutting, audio muxing, and privacy sanitization.
                    </TextBlock>

                    <!-- Highlight Badges -->
                    <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="3">
                            <TextBlock Text="⚡ Hardware GPU Accelerated" FontSize="10.5" Foreground="{DynamicResource TextBrush}"/>
                        </Border>
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="3">
                            <TextBlock Text="🎬 11 Studio Suites" FontSize="10.5" Foreground="{DynamicResource TextBrush}"/>
                        </Border>
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="3">
                            <TextBlock Text="🔒 100% Offline &amp; Private" FontSize="10.5" Foreground="{DynamicResource TextBrush}"/>
                        </Border>
                    </WrapPanel>

                    <!-- Author & Credits Card -->
                    <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,20">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center">
                                <Run Text="Built with "/>
                                <Run Text="❤️" Foreground="#F85149"/>
                                <Run Text=" by Vikash Choudhary"/>
                            </TextBlock>
                            <TextBlock Text="Powered by FFmpeg, .NET 8, and Modern WPF" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Close Button -->
                    <Button Grid.Row="4" x:Name="CloseAboutBtn" Content="Close" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Padding="32,8" Click="CloseAbout_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
