<Window x:Class="VideoFixPro.StabilizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video Stabilizer" Width="1000" Height="700" MinWidth="800" MinHeight="600"
        Background="{DynamicResource BgBrush}" AllowDrop="True" Drop="Window_Drop"
        Icon="Assets/app_icon.png">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE: Player / Drop Zone -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Border x:Name="DropZone" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="8"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🎥" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Drop a video here to stabilize" Foreground="{DynamicResource Text2Brush}" FontSize="16"/>
                </StackPanel>
            </Border>
            <Border x:Name="PlayerBorder" Visibility="Collapsed" Background="Black" CornerRadius="8" ClipToBounds="True">
                <MediaElement x:Name="Player" LoadedBehavior="Manual" MediaEnded="Player_MediaEnded" Stretch="Uniform"/>
            </Border>
        </Grid>

        <!-- RIGHT SIDE: Controls -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Stabilization Settings" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                            
                            <!-- Shakiness -->
                            <TextBlock Text="Shakiness Level" Foreground="{DynamicResource Text2Brush}" FontSize="11"/>
                            <Grid Margin="0,4,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="ShakinessSlider" Minimum="1" Maximum="10" Value="5" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding ElementName=ShakinessSlider, Path=Value}" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <!-- Smoothing -->
                            <TextBlock Text="Smoothing Radius" Foreground="{DynamicResource Text2Brush}" FontSize="11"/>
                            <Grid Margin="0,4,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SmoothingSlider" Minimum="1" Maximum="30" Value="10" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding ElementName=SmoothingSlider, Path=Value}" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Zoom -->
                            <CheckBox x:Name="ZoomCheck" Content="Auto-Zoom (Remove black borders)" IsChecked="True" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Encoder Settings" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal"   VerticalAlignment="Center">
                                <CheckBox x:Name="GpuCheck" Content="Use GPU Acceleration (if available)" IsChecked="True" Foreground="{DynamicResource TextBrush}"/>
                                <CheckBox x:Name="Av1Check" Content="AV1 Codec" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1">
                <TextBox x:Name="LogBox" Background="{DynamicResource LogBgBrush}" Foreground="{DynamicResource LogTextBrush}" FontFamily="Consolas" FontSize="10.5" Height="120" IsReadOnly="True" Margin="0,0,0,10" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="Wrap"/>
                <ProgressBar x:Name="ProgressBar" Height="15" Margin="0,0,0,10" Minimum="0" Maximum="100"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="StartBtn" Grid.Column="0" Content="Start Stabilization" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Start_Click" Height="36"/>
                    <Button x:Name="CancelBtn" Grid.Column="2" Content="Cancel" Style="{StaticResource DangerButton}" IsEnabled="False" Click="Cancel_Click" Height="36"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
