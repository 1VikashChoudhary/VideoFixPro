<Window x:Class="VideoFixPro.StabilizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Video Stabilizer — Deshake &amp; Smooth Footage"
        Width="1180" Height="760"
        MinWidth="880" MinHeight="580"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{DynamicResource BgBrush}"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        KeyDown="Window_KeyDown"
        Icon="Assets/app_icon.png">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarProgress"/>
    </Window.TaskbarItemInfo>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0,0,0,1" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>   <!-- 0: Title bar -->
            <RowDefinition Height="1"/>    <!-- 1: Separator -->
            <RowDefinition Height="*"/>    <!-- 2: Main content -->
            <RowDefinition Height="Auto"/> <!-- 3: Output & Actions -->
            <RowDefinition Height="30"/>   <!-- 4: Status bar -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════ TITLE BAR ══════════════════════ -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBrush}" MouseLeftButtonDown="TitleBar_MouseDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                <Image Source="Assets/app_icon.png" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Video Stabilizer — Deshake &amp; Smooth Footage" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource CardBrush}" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleFileName" Text="No file loaded"
                               FontSize="10" Foreground="{DynamicResource Text2Brush}" FontFamily="Segoe UI"
                               MaxWidth="400" TextTrimming="CharacterEllipsis"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="─" Style="{StaticResource TitleBarButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MinBtn_Click" ToolTip="Minimize"/>
                <Button x:Name="MaxBtn" Content="□" Style="{StaticResource TitleBarButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MaxBtn_Click" ToolTip="Maximize/Restore"/>
                <Button Content="✕" Style="{StaticResource TitleBarCloseButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseBtn_Click" ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <!-- Separator -->
        <Rectangle Grid.Row="1" Fill="{DynamicResource BorderBrush}"/>

        <!-- ══════════════════════ MAIN CONTENT ══════════════════════ -->
        <Grid Grid.Row="2" Margin="14,12,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="380"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Preview / Drop Zone -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- File Header (after load) -->
                <Border x:Name="FileHeader" Grid.Row="0" Visibility="Collapsed"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderFileName" Foreground="{DynamicResource AccentBrush}"
                                       FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxWidth="450"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock x:Name="HeaderDuration" Text="00:00:00" Foreground="{DynamicResource Text2Brush}" FontSize="11"/>
                                </Border>
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="3" Padding="6,2">
                                    <TextBlock Text="Ready to Stabilize" Foreground="{DynamicResource SuccessBrush}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Change File" Style="{StaticResource GhostButton}" Padding="10,5" Click="OpenVideo_Click" ToolTip="Load a different video file (Ctrl+O)"/>
                            <Button Content="Remove" Style="{StaticResource GhostButton}" Padding="10,5" Margin="6,0,0,0" Click="RemoveFile_Click" ToolTip="Unload video"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Drop Zone (before load) -->
                <Border x:Name="DropZone" Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="2" CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="DropZone_Click">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🎬" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Video Stabilizer" Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Drop a video file here to deshake and smooth shaky camera motion"
                                   Foreground="{DynamicResource Text2Brush}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Video Player Preview (Clean) -->
                <Border x:Name="PlayerBorder" Grid.Row="1" Visibility="Collapsed" Background="Black" CornerRadius="8" ClipToBounds="True">
                    <Viewbox x:Name="PlayerViewbox" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid x:Name="PlayerRotator">
                            <MediaElement x:Name="Player" LoadedBehavior="Manual" MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded" Stretch="Fill"/>
                        </Grid>
                    </Viewbox>
                </Border>
            </Grid>

            <!-- RIGHT: Stabilization & Encoder Settings -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Stabilization Parameters -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Stabilization Engine Settings" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                            
                            <!-- Shakiness -->
                            <TextBlock Text="Shakiness Detection Level" Foreground="{DynamicResource Text2Brush}" FontSize="11.5"/>
                            <Grid Margin="0,4,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="35"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="ShakinessSlider" Minimum="1" Maximum="10" Value="5" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding ElementName=ShakinessSlider, Path=Value}" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Grid>
                            
                            <!-- Smoothing -->
                            <TextBlock Text="Smoothing Radius (Frames Buffer)" Foreground="{DynamicResource Text2Brush}" FontSize="11.5"/>
                            <Grid Margin="0,4,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="35"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SmoothingSlider" Minimum="1" Maximum="30" Value="10" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding ElementName=SmoothingSlider, Path=Value}" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Grid>

                            <!-- Zoom -->
                            <CheckBox x:Name="ZoomCheck" Content="Auto-Zoom &amp; Crop (Removes black border artifacts)" IsChecked="True" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Hardware & Codec Settings -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Encoder Settings" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                            <CheckBox x:Name="GpuCheck" Content="GPU Hardware Acceleration (Auto-Detect)" IsChecked="True" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="Av1Check" Content="AV1 Codec (Next-Gen High Efficiency)" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Engine Telemetry Log -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Stabilization Engine Log" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                            <TextBox x:Name="LogBox" Background="{DynamicResource LogBgBrush}" Foreground="{DynamicResource LogTextBrush}"
                                     FontFamily="Consolas" FontSize="11" Height="130" IsReadOnly="True"
                                     BorderThickness="0" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ══════════════════════ OUTPUT & ACTIONS ══════════════════════ -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Output" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" FontSize="12"/>
                <TextBox x:Name="OutputDirBox" Grid.Column="1" IsReadOnly="True" VerticalAlignment="Center" Margin="8,0"
                         Text="Same as source file" Foreground="{DynamicResource Text2Brush}" Background="{DynamicResource CardBrush}"/>
                <Button Grid.Column="2" Content="Browse" Style="{StaticResource GhostButton}" Padding="10,5" Click="BrowseOutput_Click"/>
                <Button Grid.Column="3" Content="Reset" Style="{StaticResource GhostButton}" Padding="10,5" Margin="4,0,0,0" Click="ResetOutput_Click"/>
                <Button x:Name="OpenFolderBtn" Grid.Column="4" Content="Open Folder" Style="{StaticResource GhostButton}"
                        Padding="10,5" Margin="4,0,0,0" IsEnabled="False" Click="OpenFolder_Click" ToolTip="Open output folder in Explorer"/>

                <Button x:Name="StartBtn" Grid.Column="6" Content="⚡ Start Stabilization" Style="{StaticResource PrimaryButton}"
                        Padding="18,7" IsEnabled="False" Click="Start_Click"/>
                <Button x:Name="CancelBtn" Grid.Column="8" Content="Cancel" Style="{StaticResource DangerButton}"
                        Padding="14,7" IsEnabled="False" Click="Cancel_Click"/>
            </Grid>
        </Border>

        <!-- ══════════════════════ STATUS BAR ══════════════════════ -->
        <Grid Grid.Row="4" Background="{DynamicResource TitleBarBrush}">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Ready — Drag &amp; drop a video file to stabilize" Foreground="{DynamicResource Text2Brush}" FontSize="11"/>
                    <ProgressBar x:Name="ProgressBar" Width="140" Height="12" Margin="12,0,0,0" Visibility="Collapsed" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="ProgressPercentText" Text="0%" Foreground="{DynamicResource TextBrush}" FontSize="11" Margin="6,0,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Video Stabilizer Pro" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
