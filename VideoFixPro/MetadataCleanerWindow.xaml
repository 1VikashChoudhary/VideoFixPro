<Window x:Class="VideoFixPro.MetadataCleanerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:VideoFixPro"
        Title="Metadata Cleaner &amp; Privacy Shield"
        Width="1260" Height="800"
        MinWidth="960" MinHeight="620"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{StaticResource BgBrush}"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Icon="Assets/app_icon.png">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarProgress"/>
    </Window.TaskbarItemInfo>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0,0,0,1" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>   <!-- Title bar -->
            <RowDefinition Height="1"/>    <!-- Separator -->
            <RowDefinition Height="*"/>    <!-- Main content -->
            <RowDefinition Height="Auto"/> <!-- Output settings & actions -->
            <RowDefinition Height="30"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ════════════════ TITLE BAR ════════════════ -->
        <Grid Grid.Row="0" Background="{StaticResource TitleBarBrush}" MouseLeftButtonDown="TitleBar_MouseDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                <TextBlock Text="🛡️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Metadata Cleaner &amp; Privacy Shield" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                <Border Background="#21262D" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleFileName" Text="No file loaded"
                               FontSize="10" Foreground="{StaticResource Text2Brush}" FontFamily="Segoe UI"
                               MaxWidth="400" TextTrimming="CharacterEllipsis"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="─" Style="{StaticResource TitleBarButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MinBtn_Click" ToolTip="Minimize"/>
                <Button x:Name="MaxBtn" Content="□" Style="{StaticResource TitleBarButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MaxBtn_Click" ToolTip="Maximize/Restore"/>
                <Button Content="✕" Style="{StaticResource TitleBarCloseButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseBtn_Click" ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <!-- Separator -->
        <Rectangle Grid.Row="1" Fill="{StaticResource BorderBrush}"/>

        <!-- ════════════════ MAIN CONTENT ════════════════ -->
        <Grid Grid.Row="2" Margin="14,12,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="380"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2.5*" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <!-- ─────── LEFT: METADATA & PRIVACY INSPECTOR ─────── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Drop Zone (before load) -->
                <Border x:Name="DropZone" Grid.Row="0" Grid.RowSpan="2"
                        BorderBrush="{StaticResource MutedBrush}" BorderThickness="2" CornerRadius="8"
                        Background="{StaticResource SurfaceBrush}" Cursor="Hand" MouseLeftButtonDown="DropZone_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1C2128"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🛡️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Metadata Cleaner &amp; Privacy Shield" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Drop a video file to inspect and sanitize private EXIF / GPS tags"
                                   Foreground="{StaticResource Text2Brush}" FontFamily="Segoe UI" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Text="or click to browse  •  Instant Lossless Sanitization in Milliseconds"
                                   Foreground="{StaticResource MutedBrush}" FontFamily="Segoe UI" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- File Header (after load) -->
                <Border x:Name="FileHeader" Grid.Row="0" Visibility="Collapsed"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderFileName" Foreground="{StaticResource AccentBrush}"
                                       FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxWidth="450"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Background="{StaticResource CardBrush}" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock x:Name="HeaderDuration" Text="00:00:00" Foreground="{StaticResource Text2Brush}" FontSize="11"/>
                                </Border>
                                <Border Background="{StaticResource CardBrush}" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock x:Name="HeaderFileSize" Text="0 MB" Foreground="{StaticResource Text2Brush}" FontSize="11"/>
                                </Border>
                                <Border Background="{StaticResource CardBrush}" CornerRadius="3" Padding="6,2">
                                    <TextBlock x:Name="HeaderResolution" Text="1920x1080" Foreground="{StaticResource Text2Brush}" FontSize="11"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Change File" Style="{StaticResource GhostButton}" Padding="10,5" Click="ChangeFile_Click"/>
                            <Button Content="Remove" Style="{StaticResource GhostButton}" Padding="10,5" Margin="6,0,0,0" Click="RemoveFile_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Metadata Inspector Card -->
                <Border x:Name="MetadataCard" Grid.Row="1" Visibility="Collapsed"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Top Privacy Badges -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="🔍 Detected Metadata &amp; Privacy Information" Foreground="{StaticResource TextBrush}"
                                       FontWeight="SemiBold" FontSize="13" FontFamily="Segoe UI"/>

                            <!-- GPS Location Bar -->
                            <Border x:Name="GpsAlertBorder" Background="#2A1B1B" BorderBrush="#F85149" BorderThickness="1"
                                    CornerRadius="6" Padding="10,8" Margin="0,8,0,0" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📍" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Exact GPS Geolocation Detected!" Foreground="#FF7B72" FontWeight="Bold" FontSize="11.5"/>
                                        <TextBlock x:Name="GpsCoordsText" Text="Lat: 0.000, Lon: 0.000" Foreground="{StaticResource Text2Brush}" FontSize="10.5"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="🗺️ View Map" Style="{StaticResource GhostButton}" Padding="10,4" FontSize="10.5" Click="OpenMap_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Raw Metadata Key-Value List -->
                        <DataGrid x:Name="MetadataGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserDeleteRows="False" CanUserResizeRows="False"
                                  Background="{StaticResource CardBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                  RowHeaderWidth="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                  Foreground="{StaticResource TextBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tag Property" Binding="{Binding Key}" Width="160" FontWeight="SemiBold" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ─────── RIGHT: PRIVACY CLEANING OPTIONS ─────── -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Sanitization Checklist -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="🛡️ Sanitization Checklist" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="13" FontFamily="Segoe UI"/>
                            <TextBlock Text="Select metadata layers to strip:" Foreground="{StaticResource Text2Brush}" FontSize="11" Margin="0,4,0,8"/>

                            <CheckBox x:Name="StripGpsCheck" Content="Strip GPS &amp; Geolocation Coordinates"
                                      Foreground="{StaticResource TextBrush}" Margin="0,6,0,0" IsChecked="True" Cursor="Hand"/>
                            <TextBlock Text="Removes exact latitude, longitude, altitude, and location name tags."
                                       Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="24,2,0,8"/>

                            <CheckBox x:Name="StripCameraCheck" Content="Strip Device &amp; Camera Hardware IDs"
                                      Foreground="{StaticResource TextBrush}" Margin="0,4,0,0" IsChecked="True" Cursor="Hand"/>
                            <TextBlock Text="Removes camera make/model, serial numbers, lens info, and device IDs."
                                       Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="24,2,0,8"/>

                            <CheckBox x:Name="StripEncoderCheck" Content="Strip Creation Date &amp; Software Tags"
                                      Foreground="{StaticResource TextBrush}" Margin="0,4,0,0" IsChecked="True" Cursor="Hand"/>
                            <TextBlock Text="Wipes editing software names, operating system identifiers, and timestamps."
                                       Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="24,2,0,8"/>

                            <CheckBox x:Name="StripChaptersCheck" Content="Strip Chapters &amp; Markers"
                                      Foreground="{StaticResource TextBrush}" Margin="0,4,0,0" IsChecked="False" Cursor="Hand"/>

                            <CheckBox x:Name="StripAllCheck" Content="Complete Deep Wipe (Sanitize All Unknown Tags)"
                                      Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" Margin="0,8,0,0" IsChecked="True" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <!-- Processing Engine -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="⚡ Instant Lossless Engine" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="13" FontFamily="Segoe UI"/>
                            <TextBlock Text="Sanitizes headers directly using stream copy. Takes &lt; 1 second per file without re-encoding or quality loss."
                                       Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0" LineHeight="16" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- FFmpeg Log (Collapsible) -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Sanitizer Log" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="12" FontFamily="Segoe UI"/>
                                <Button x:Name="ToggleLogBtn" Content="Show" HorizontalAlignment="Right" Style="{StaticResource GhostButton}"
                                        Padding="8,2" FontSize="10" Click="ToggleLog_Click"/>
                            </Grid>
                            <TextBox x:Name="LogBox" Margin="0,8,0,0" Height="100" Visibility="Collapsed"
                                     Background="{StaticResource LogBgBrush}" Foreground="{StaticResource LogTextBrush}"
                                     BorderThickness="0" FontFamily="Consolas" FontSize="10.5" IsReadOnly="True"
                                     TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ════════════════ OUTPUT & ACTIONS ════════════════ -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Output" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" FontSize="12"/>
                <TextBlock x:Name="OutputPathText" Grid.Column="1" Text="Same as source file"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="2" Content="Browse" Style="{StaticResource GhostButton}" Padding="10,5" Click="BrowseOutput_Click"/>
                <Button Grid.Column="3" Content="Reset" Style="{StaticResource GhostButton}" Padding="10,5" Margin="6,0,0,0" Click="ResetOutput_Click"/>

                <!-- Progress Column -->
                <Grid x:Name="RenderProgressPanel" Grid.Column="5" VerticalAlignment="Center" Visibility="Collapsed">
                    <ProgressBar x:Name="RenderProgressBar" Height="18" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="RenderProgressText" Text="0%" Foreground="{StaticResource TextBrush}"
                               FontFamily="Consolas" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <Button x:Name="CancelBtn" Grid.Column="7" Content="Cancel" Style="{StaticResource DangerButton}"
                        Padding="16,7" Visibility="Collapsed" Click="Cancel_Click"/>
                <Button x:Name="OpenFolderBtn" Grid.Column="9" Content="Open Folder" Style="{StaticResource GhostButton}"
                        Padding="12,7" IsEnabled="False" Click="OpenFolder_Click"/>
                <Button x:Name="SanitizeBtn" Grid.Column="11" Content="🛡️ Sanitize &amp; Clean Video" Style="{StaticResource PrimaryButton}"
                        Padding="24,7" FontWeight="Bold" Click="Sanitize_Click"/>
            </Grid>
        </Border>

        <!-- ════════════════ STATUS BAR ════════════════ -->
        <Grid Grid.Row="4" Background="{StaticResource TitleBarBrush}">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" Text="Ready" FontSize="11" FontFamily="Segoe UI"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Foreground="{StaticResource MutedBrush}" Text="Privacy Shield for VideoFixPro" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
