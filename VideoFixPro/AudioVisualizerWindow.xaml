<Window x:Class="VideoFixPro.AudioVisualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio Visualizer" Width="1000" Height="700" MinWidth="800" MinHeight="600"
        Background="{DynamicResource BgBrush}" AllowDrop="True" Drop="Window_Drop"
        Icon="Assets/app_icon.png">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="Generate Video" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="Generate_Click"/>
                <Button Content="Cancel" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Click="Cancel_Click"/>
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Text2Brush}" Text="Drop an AUDIO file here to generate visualizer video."/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                        
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Input Audio" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
                            <TextBox x:Name="InputAudioBox" Grid.Column="1" IsReadOnly="True" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4"/>
                        </Grid>
                        
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Background Image" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
                            <TextBox x:Name="BackgroundImageBox" Grid.Column="1" IsReadOnly="True" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="Browse..." Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="BrowseBg_Click"/>
                                <Button Content="Clear" Style="{StaticResource GhostButton}" Margin="4,0,0,0" Click="ClearBg_Click"/>
                            </StackPanel>
                        </Grid>
                        
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Visualizer Style" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="StyleBox" Grid.Column="1" Width="200" HorizontalAlignment="Left" SelectedIndex="0">
                                <ComboBoxItem Content="Waveform (cline)"/>
                                <ComboBoxItem Content="Frequency Bars (showfreqs)"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
            
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="FFmpeg Log" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                    <TextBox x:Name="LogBox" Grid.Row="1" Margin="0,12,0,0" Background="{DynamicResource LogBgBrush}" Foreground="{DynamicResource LogTextBrush}" BorderThickness="0" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" AcceptsTab="True" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Progress" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
            <ProgressBar x:Name="ProcessProgressBar" Grid.Column="1" Margin="10,0" Height="18" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="ProcessProgressText" Grid.Column="2" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Text="0%"/>
        </Grid>
    </Grid>
</Window>
