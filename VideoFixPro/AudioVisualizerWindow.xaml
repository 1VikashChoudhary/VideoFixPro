<Window x:Class="VideoFixPro.AudioVisualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Podcast &amp; Audio Visualizer — Audio to Video"
        Width="1180" Height="760"
        MinWidth="880" MinHeight="580"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{DynamicResource BgBrush}"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        KeyDown="Window_KeyDown"
        Icon="Assets/app_icon.png">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarProgress"/>
    </Window.TaskbarItemInfo>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0,0,0,1" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>   <!-- 0: Title bar -->
            <RowDefinition Height="1"/>    <!-- 1: Separator -->
            <RowDefinition Height="*"/>    <!-- 2: Main content -->
            <RowDefinition Height="Auto"/> <!-- 3: Output & Actions -->
            <RowDefinition Height="30"/>   <!-- 4: Status bar -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════ TITLE BAR ══════════════════════ -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBrush}" MouseLeftButtonDown="TitleBar_MouseDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                <Image Source="Assets/app_icon.png" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Podcast &amp; Audio Visualizer — Audio to Video" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource CardBrush}" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleFileName" Text="No file loaded"
                               FontSize="10" Foreground="{DynamicResource Text2Brush}" FontFamily="Segoe UI"
                               MaxWidth="400" TextTrimming="CharacterEllipsis"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="─" Style="{StaticResource TitleBarButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MinBtn_Click" ToolTip="Minimize"/>
                <Button x:Name="MaxBtn" Content="□" Style="{StaticResource TitleBarButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MaxBtn_Click" ToolTip="Maximize/Restore"/>
                <Button Content="✕" Style="{StaticResource TitleBarCloseButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseBtn_Click" ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <!-- Separator -->
        <Rectangle Grid.Row="1" Fill="{DynamicResource BorderBrush}"/>

        <!-- ══════════════════════ MAIN CONTENT ══════════════════════ -->
        <Grid Grid.Row="2" Margin="14,12,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="380"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Drop Zone & Preview -->
            <Grid Grid.Column="0">
                <Border x:Name="DropZone" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="2" CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="DropZone_Click">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🎙️" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Podcast &amp; Audio Visualizer" Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Drop an audio file (MP3, WAV, AAC, M4A) here to create video waveform"
                                   Foreground="{DynamicResource Text2Brush}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RIGHT: Settings & Log -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Visualizer Settings -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Visualizer Settings" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>
                            
                            <!-- Input Audio -->
                            <TextBlock Text="Input Audio File" Foreground="{DynamicResource Text2Brush}" FontSize="11.5"/>
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InputAudioBox" IsReadOnly="True" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" Padding="8,5"/>
                                <Button Grid.Column="1" Content="Browse Audio" Style="{StaticResource GhostButton}" Padding="10,4" Margin="6,0,0,0" Click="BrowseAudio_Click"/>
                            </Grid>

                            <!-- Background Image -->
                            <TextBlock Text="Background Image (Optional)" Foreground="{DynamicResource Text2Brush}" FontSize="11.5"/>
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="BackgroundImageBox" IsReadOnly="True" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" Padding="8,5"/>
                                <Button Grid.Column="1" Content="Browse" Style="{StaticResource GhostButton}" Padding="10,4" Margin="6,0,0,0" Click="BrowseBg_Click"/>
                                <Button Grid.Column="2" Content="Clear" Style="{StaticResource DangerButton}" Padding="10,4" Margin="4,0,0,0" Click="ClearBg_Click"/>
                            </Grid>

                            <!-- Style -->
                            <TextBlock Text="Waveform Animation Style" Foreground="{DynamicResource Text2Brush}" FontSize="11.5"/>
                            <ComboBox x:Name="StyleBox" SelectedIndex="0" Margin="0,4,0,10">
                                <ComboBoxItem Content="Waveform Line (Smooth Center Line)"/>
                                <ComboBoxItem Content="Frequency Bars (Dynamic Equalizer)"/>
                            </ComboBox>

                            <!-- Codec -->
                            <TextBlock Text="Video Codec" Foreground="{DynamicResource Text2Brush}" FontSize="11.5"/>
                            <ComboBox x:Name="CodecBox" SelectedIndex="0" Margin="0,4,0,0">
                                <ComboBoxItem Content="H.264 (Universal Compatibility)"/>
                                <ComboBoxItem Content="AV1 (Next-Gen High Efficiency)"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Telemetry Log -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Visualizer Engine Log" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                            <TextBox x:Name="LogBox" Background="{DynamicResource LogBgBrush}" Foreground="{DynamicResource LogTextBrush}"
                                     BorderThickness="0" FontFamily="Consolas" FontSize="11" Height="140"
                                     AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ══════════════════════ OUTPUT & ACTIONS ══════════════════════ -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Output" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" FontSize="12"/>
                <TextBox x:Name="OutputDirBox" Grid.Column="1" IsReadOnly="True" VerticalAlignment="Center" Margin="8,0"
                         Text="Same as source audio folder" Foreground="{DynamicResource Text2Brush}" Background="{DynamicResource CardBrush}"/>
                <Button Grid.Column="2" Content="Browse" Style="{StaticResource GhostButton}" Padding="10,5" Click="BrowseOutput_Click"/>
                <Button Grid.Column="3" Content="Reset" Style="{StaticResource GhostButton}" Padding="10,5" Margin="4,0,0,0" Click="ResetOutput_Click"/>
                <Button x:Name="OpenFolderBtn" Grid.Column="4" Content="Open Folder" Style="{StaticResource GhostButton}"
                        Padding="10,5" Margin="4,0,0,0" IsEnabled="False" Click="OpenFolder_Click" ToolTip="Open output folder in Explorer"/>

                <Button x:Name="GenerateBtn" Grid.Column="6" Content="⚡ Generate Video" Style="{StaticResource PrimaryButton}"
                        Padding="18,7" IsEnabled="False" Click="Generate_Click"/>
                <Button x:Name="CancelBtn" Grid.Column="8" Content="Cancel" Style="{StaticResource DangerButton}"
                        Padding="14,7" IsEnabled="False" Click="Cancel_Click"/>
            </Grid>
        </Border>

        <!-- ══════════════════════ STATUS BAR ══════════════════════ -->
        <Grid Grid.Row="4" Background="{DynamicResource TitleBarBrush}">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Ready — Drag &amp; drop an audio file to generate video" Foreground="{DynamicResource Text2Brush}" FontSize="11"/>
                    <ProgressBar x:Name="ProgressBar" Width="140" Height="12" Margin="12,0,0,0" Visibility="Collapsed" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="ProgressPercentText" Text="0%" Foreground="{DynamicResource TextBrush}" FontSize="11" Margin="6,0,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Podcast Visualizer Pro" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
