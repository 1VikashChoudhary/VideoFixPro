<Window x:Class="VideoFixPro.SocialFormatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Social Media Format &amp; Resize"
        Width="1180" Height="780"
        MinWidth="960" MinHeight="640"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{DynamicResource BgBrush}"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        KeyDown="Window_KeyDown"
        Icon="Assets/app_icon.png">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0,0,0,1" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarProgress"/>
    </Window.TaskbarItemInfo>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>   <!-- 0: Title bar -->
            <RowDefinition Height="1"/>    <!-- 1: Separator -->
            <RowDefinition Height="*"/>    <!-- 2: Main content -->
            <RowDefinition Height="Auto"/> <!-- 3: Output & Actions -->
            <RowDefinition Height="30"/>   <!-- 4: Status bar -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════ TITLE BAR ══════════════════════ -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBrush}" MouseLeftButtonDown="TitleBar_MouseDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                <Image Source="Assets/app_icon.png" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Social Media Format &amp; Resize" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource CardBrush}" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleFileName" Text="No file loaded"
                               FontSize="10" Foreground="{DynamicResource Text2Brush}" FontFamily="Segoe UI"
                               MaxWidth="400" TextTrimming="CharacterEllipsis"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="─" Style="{StaticResource TitleBarButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MinBtn_Click" ToolTip="Minimize"/>
                <Button x:Name="MaxBtn" Content="□" Style="{StaticResource TitleBarButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MaxBtn_Click" ToolTip="Maximize/Restore"/>
                <Button Content="✕" Style="{StaticResource TitleBarCloseButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseBtn_Click" ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <!-- Separator -->
        <Rectangle Grid.Row="1" Fill="{DynamicResource BorderBrush}"/>

        <!-- ══════════════════════ MAIN CONTENT ══════════════════════ -->
        <Grid Grid.Row="2" Margin="14,12,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="420"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Live Interactive Preview & Playback Controls -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: File Header (after load) -->
                    <RowDefinition Height="*"/>    <!-- 1: Live Preview Viewport Host / Drop Zone -->
                    <RowDefinition Height="Auto"/> <!-- 2: Playback & Seek Bar -->
                </Grid.RowDefinitions>

                <!-- File Header (after load) -->
                <Border x:Name="FileHeader" Grid.Row="0" Visibility="Collapsed"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderFileName" Foreground="{DynamicResource AccentBrush}"
                                       FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxWidth="450"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock x:Name="HeaderDuration" Text="00:00:00" Foreground="{DynamicResource Text2Brush}" FontSize="11"/>
                                </Border>
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock x:Name="HeaderResolution" Text="1920x1080" Foreground="{DynamicResource Text2Brush}" FontSize="11"/>
                                </Border>
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="3" Padding="6,2">
                                    <TextBlock x:Name="HeaderRatio" Text="16:9 Landscape" Foreground="{DynamicResource Text2Brush}" FontSize="11"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Change File" Style="{StaticResource GhostButton}" Padding="10,5" Click="OpenVideo_Click" ToolTip="Load a different video file (Ctrl+O)"/>
                            <Button Content="Remove" Style="{StaticResource GhostButton}" Padding="10,5" Margin="6,0,0,0" Click="RemoveFile_Click" ToolTip="Unload current video"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Drop Zone (shown when empty) -->
                <Border x:Name="DropZone" Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="2" CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="DropZone_Click">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📱" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Social Media Resizer Pro" Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Drop a video here for live interactive aspect ratio conversion"
                                   Foreground="{DynamicResource Text2Brush}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        <TextBlock Text="TikTok · Instagram Reels · YouTube Shorts · 1:1 Square"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Live Preview Viewport Host -->
                <Border x:Name="PreviewHost" Grid.Row="1" Visibility="Collapsed" Background="#0D1117"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" ClipToBounds="True" SizeChanged="PreviewHost_SizeChanged">
                    <Grid>
                        <!-- Centered Aspect-Ratio Constrained Canvas Frame -->
                        <Border x:Name="CanvasFrame" HorizontalAlignment="Center" VerticalAlignment="Center"
                                CornerRadius="6" ClipToBounds="True" Background="Black"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <!-- Layer 1: Solid Background Color Layer -->
                                <Border x:Name="BgSolidLayer" Background="Black" Visibility="Collapsed"/>

                                <!-- Layer 2: Dynamic Blurred Video Background Layer -->
                                <MediaElement x:Name="BgPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                              Stretch="UniformToFill" IsMuted="True" ScrubbingEnabled="True"
                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <MediaElement.Effect>
                                        <BlurEffect x:Name="BgBlurEffect" Radius="25" KernelType="Gaussian"/>
                                    </MediaElement.Effect>
                                </MediaElement>

                                <!-- Layer 3: Main Foreground Video Layer (Sharp & Scaled) -->
                                <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                              Stretch="Uniform" ScrubbingEnabled="True"
                                              MediaOpened="Player_MediaOpened"
                                              MediaEnded="Player_MediaEnded"
                                              MediaFailed="Player_MediaFailed"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <!-- Layer 4: Live Format Overlay Badge (Top-Left) -->
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="10" Background="#B0000000" CornerRadius="4" Padding="8,4">
                                    <TextBlock x:Name="PreviewBadgeText" Text="⚡ LIVE PREVIEW · 9:16 (1080×1920)"
                                               Foreground="{DynamicResource AccentBrush}" FontSize="10.5" FontWeight="Bold"/>
                                </Border>

                                <!-- Layer 5: Large Center Play/Pause Overlay Button -->
                                <Button x:Name="PlayOverlayBtn" Width="64" Height="64"
                                        Style="{StaticResource GhostButton}" FontSize="28" Content="▶"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Opacity="0.8" Visibility="Collapsed" Click="TogglePlay_Click"
                                        ToolTip="Play / Pause (Space)"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Playback & Scrubbing Control Bar -->
                <Border x:Name="SeekPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,8,0,0"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Play/Pause button -->
                            <ColumnDefinition Width="*"/>    <!-- Seek slider -->
                            <ColumnDefinition Width="Auto"/> <!-- Time display -->
                            <ColumnDefinition Width="Auto"/> <!-- Mute button -->
                            <ColumnDefinition Width="70"/>   <!-- Volume slider -->
                        </Grid.ColumnDefinitions>

                        <!-- Play/Pause Button -->
                        <Button x:Name="SeekPlayBtn" Content="▶" Width="36" Height="28" Padding="0" FontSize="11"
                                Style="{StaticResource GhostButton}" Click="TogglePlay_Click"
                                VerticalAlignment="Center" ToolTip="Play / Pause (Space)"/>

                        <!-- Seek Slider -->
                        <Slider x:Name="SeekSlider" Grid.Column="1" Margin="10,0"
                                Minimum="0" Maximum="100" Value="0"
                                VerticalAlignment="Center"
                                PreviewMouseLeftButtonDown="SeekSlider_MouseDown"
                                PreviewMouseLeftButtonUp="SeekSlider_MouseUp"
                                ValueChanged="SeekSlider_ValueChanged"/>

                        <!-- Time display -->
                        <TextBlock x:Name="SeekTimeText" Grid.Column="2" Text="00:00:00 / 00:00:00"
                                   Foreground="{DynamicResource Text2Brush}" FontFamily="Consolas"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <!-- Mute / Unmute Button -->
                        <Button x:Name="MuteBtn" Grid.Column="3" Content="🔊" Width="30" Height="28" Padding="0" FontSize="11"
                                Style="{StaticResource GhostButton}" Click="MuteToggle_Click"
                                VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Mute / Unmute"/>

                        <!-- Volume Slider -->
                        <Slider x:Name="VolumeSlider" Grid.Column="4" Minimum="0" Maximum="1" Value="0.5"
                                SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center"
                                ValueChanged="VolumeSlider_ValueChanged" ToolTip="Preview Volume"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT: Interactive Settings Panel -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Format Parameters -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Formatting Settings" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>
                            
                            <!-- Target Aspect Ratio -->
                            <TextBlock Text="Target Aspect Ratio (Platform)" Foreground="{DynamicResource Text2Brush}" FontSize="11.5"/>
                            <ComboBox x:Name="RatioBox" SelectedIndex="0" Margin="0,4,0,12" SelectionChanged="RatioBox_SelectionChanged">
                                <ComboBoxItem Content="9:16 Vertical (TikTok, Reels, Shorts)"/>
                                <ComboBoxItem Content="1:1 Square (Instagram, Facebook Feed)"/>
                                <ComboBoxItem Content="4:5 Portrait (Instagram Feed)"/>
                                <ComboBoxItem Content="16:9 Landscape (YouTube, Twitter)"/>
                            </ComboBox>
                            
                            <!-- Background Fill Mode -->
                            <TextBlock Text="Background Fill Mode" Foreground="{DynamicResource Text2Brush}" FontSize="11.5"/>
                            <ComboBox x:Name="BgModeBox" SelectedIndex="0" Margin="0,4,0,12" SelectionChanged="BgModeBox_SelectionChanged">
                                <ComboBoxItem Content="Dynamic Blurred Video (Cinematic)"/>
                                <ComboBoxItem Content="Solid Black"/>
                                <ComboBoxItem Content="Solid White"/>
                            </ComboBox>

                            <!-- Blur Intensity -->
                            <StackPanel x:Name="BlurIntensityPanel">
                                <TextBlock Text="Background Blur Intensity" Foreground="{DynamicResource Text2Brush}" FontSize="11.5"/>
                                <Grid Margin="0,4,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="BlurSlider" Minimum="5" Maximum="50" Value="25" TickFrequency="1"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            ValueChanged="BlurSlider_ValueChanged"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=BlurSlider, Path=Value, StringFormat='{}{0}px'}"
                                               Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </Grid>
                                <TextBlock Text="Adjust blur intensity in real-time preview" Foreground="{DynamicResource MutedBrush}" FontSize="10.5"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Hardware & Codec Settings -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Encoder Settings" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                            <CheckBox x:Name="GpuCheck" Content="GPU Hardware Acceleration (Auto-Detect)" IsChecked="True" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="Av1Check" Content="AV1 Codec (Next-Gen High Efficiency)" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Engine Telemetry Log -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Text="FFmpeg Engine Log" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                            <TextBox x:Name="LogBox" Background="{DynamicResource LogBgBrush}" Foreground="{DynamicResource LogTextBrush}"
                                     FontFamily="Consolas" FontSize="11" Height="130" IsReadOnly="True"
                                     BorderThickness="0" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ══════════════════════ OUTPUT & ACTIONS ══════════════════════ -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Output" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" FontSize="12"/>
                <TextBox x:Name="OutputDirBox" Grid.Column="1" IsReadOnly="True" VerticalAlignment="Center" Margin="8,0"
                         Text="Same as source file" Foreground="{DynamicResource Text2Brush}" Background="{DynamicResource CardBrush}"/>
                <Button Grid.Column="2" Content="Browse" Style="{StaticResource GhostButton}" Padding="10,5" Click="BrowseOutput_Click"/>
                <Button Grid.Column="3" Content="Reset" Style="{StaticResource GhostButton}" Padding="10,5" Margin="4,0,0,0" Click="ResetOutput_Click"/>
                <Button x:Name="OpenFolderBtn" Grid.Column="4" Content="Open Folder" Style="{StaticResource GhostButton}"
                        Padding="10,5" Margin="4,0,0,0" IsEnabled="False" Click="OpenFolder_Click" ToolTip="Open output folder in Explorer"/>

                <Button x:Name="StartBtn" Grid.Column="6" Content="⚡ Format Video" Style="{StaticResource PrimaryButton}"
                        Padding="18,7" IsEnabled="False" Click="Start_Click"/>
                <Button x:Name="CancelBtn" Grid.Column="8" Content="Cancel" Style="{StaticResource DangerButton}"
                        Padding="14,7" IsEnabled="False" Click="Cancel_Click"/>
            </Grid>
        </Border>

        <!-- ══════════════════════ STATUS BAR ══════════════════════ -->
        <Grid Grid.Row="4" Background="{DynamicResource TitleBarBrush}">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Ready — Drag &amp; drop a video file to convert" Foreground="{DynamicResource Text2Brush}" FontSize="11"/>
                    <ProgressBar x:Name="ProgressBar" Width="140" Height="12" Margin="12,0,0,0" Visibility="Collapsed" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="ProgressPercentText" Text="0%" Foreground="{DynamicResource TextBrush}" FontSize="11" Margin="6,0,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Social Media Resizer Pro" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
