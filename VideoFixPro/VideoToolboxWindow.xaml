<Window x:Class="VideoFixPro.VideoToolboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:VideoFixPro"
        Title="Video Toolbox"
        Width="1320" Height="860"
        MinWidth="1000" MinHeight="700"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{DynamicResource BgBrush}"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Icon="Assets/app_icon.png">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0,0,0,1" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarProgress"/>
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Active button accent style -->
        <Style x:Key="ActiveToolButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="#1F3152"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Ghost ToggleButton style -->
        <Style x:Key="GhostToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#21262D"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1F3152"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>   <!-- Title bar -->
            <RowDefinition Height="1"/>    <!-- Separator -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Output panel -->
            <RowDefinition Height="30"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ════════════════ TITLE BAR ════════════════ -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBrush}"
              MouseLeftButtonDown="TitleBar_MouseDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                <Image Source="Assets/app_icon.png" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Video Toolbox" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           FontFamily="Segoe UI" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource CardBrush}" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleFileName" Text="No file loaded"
                               FontSize="10" Foreground="{DynamicResource Text2Brush}"
                               FontFamily="Segoe UI" MaxWidth="450"
                               TextTrimming="CharacterEllipsis"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="─" Style="{StaticResource TitleBarButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MinBtn_Click" ToolTip="Minimize"/>
                <Button x:Name="MaxBtn" Content="□" Style="{StaticResource TitleBarButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MaxBtn_Click" ToolTip="Maximize/Restore"/>
                <Button Content="✕" Style="{StaticResource TitleBarCloseButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseBtn_Click" ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <!-- Separator -->
        <Rectangle Grid.Row="1" Fill="{DynamicResource BorderBrush}"/>

        <!-- ════════════════ MAIN CONTENT ════════════════ -->
        <Grid Grid.Row="2" Margin="14,10,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="480"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="2*" MinWidth="340" MaxWidth="440"/>
            </Grid.ColumnDefinitions>

            <!-- ─────── LEFT: PREVIEW & TIMELINE PANEL ─────── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Drop zone / file header -->
                    <RowDefinition Height="*"/>     <!-- Live video preview -->
                    <RowDefinition Height="Auto"/>  <!-- Seek bar -->
                    <RowDefinition Height="Auto"/>  <!-- Filmstrip & Waveform timeline -->
                    <RowDefinition Height="Auto"/>  <!-- Edit summary badge -->
                </Grid.RowDefinitions>

                <!-- Drop zone (visible until file loaded) -->
                <Border x:Name="DropZone" Grid.Row="0" Grid.RowSpan="5"
                        BorderBrush="{DynamicResource MutedBrush}"
                        BorderThickness="2" CornerRadius="8"
                        Background="{DynamicResource SurfaceBrush}"
                        Cursor="Hand"
                        MouseLeftButtonDown="DropZone_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1C2128"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🎬 Video Toolbox" FontSize="26" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Drop a video file here for live interactive editing"
                                   Foreground="{DynamicResource Text2Brush}"
                                   FontFamily="Segoe UI" FontSize="13"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="or click to browse  ·  MP4, MKV, AVI, MOV, WMV, FLV, WebM"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontFamily="Segoe UI" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- File header (replaces drop zone after load) -->
                <Border x:Name="FileHeader" Grid.Row="0" Visibility="Collapsed"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderFileName"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxWidth="440"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock x:Name="HeaderDuration" Text="-"
                                               Foreground="{DynamicResource Text2Brush}" FontFamily="Segoe UI" FontSize="11"/>
                                </Border>
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock x:Name="HeaderCodec" Text="-"
                                               Foreground="{DynamicResource Text2Brush}" FontFamily="Segoe UI" FontSize="11"/>
                                </Border>
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock x:Name="HeaderResolution" Text="-"
                                               Foreground="{DynamicResource Text2Brush}" FontFamily="Segoe UI" FontSize="11"/>
                                </Border>
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="3" Padding="6,2">
                                    <TextBlock x:Name="HeaderAudioInfo" Text="-"
                                               Foreground="{DynamicResource Text2Brush}" FontFamily="Segoe UI" FontSize="11"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Change File" Style="{StaticResource GhostButton}" Padding="10,5" Click="ChangeFile_Click"/>
                            <Button Content="Remove" Style="{StaticResource GhostButton}" Padding="10,5" Margin="6,0,0,0" Click="RemoveFile_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Live Video preview with real-time Transform & Crop Overlay -->
                <Border x:Name="PlayerBorder" Grid.Row="1" Margin="0,8,0,0"
                        Background="Black" CornerRadius="8" ClipToBounds="True"
                        Visibility="Collapsed"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        SizeChanged="PlayerBorder_SizeChanged">
                    <Grid>
                        <!-- Video Host with RenderTransformOrigin and TransformGroup -->
                        <Grid x:Name="PlayerTransformHost" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="PlayerScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="PlayerTranslate" X="0" Y="0"/>
                                    <RotateTransform x:Name="PlayerRotate" Angle="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <MediaElement x:Name="Player"
                                          LoadedBehavior="Manual"
                                      UnloadedBehavior="Stop"
                                      ScrubbingEnabled="True"
                                      Volume="0.5"
                                      Stretch="Uniform"
                                      MediaOpened="Player_MediaOpened"
                                      MediaEnded="Player_MediaEnded"
                                      MediaFailed="Player_MediaFailed"/>
                        </Grid>

                        <!-- Live Interactive Drag-to-Crop Canvas -->
                        <Canvas x:Name="CropCanvas"
                                Background="Transparent"
                                Visibility="Collapsed"
                                MouseDown="CropCanvas_MouseDown"
                                MouseMove="CropCanvas_MouseMove"
                                MouseUp="CropCanvas_MouseUp"
                                MouseLeave="CropCanvas_MouseLeave">

                            <!-- Dark Dimmed Masks for outside unselected region -->
                            <Rectangle x:Name="MaskTop" Fill="#99000000" IsHitTestVisible="False"/>
                            <Rectangle x:Name="MaskBottom" Fill="#99000000" IsHitTestVisible="False"/>
                            <Rectangle x:Name="MaskLeft" Fill="#99000000" IsHitTestVisible="False"/>
                            <Rectangle x:Name="MaskRight" Fill="#99000000" IsHitTestVisible="False"/>

                            <!-- Main Crop Box with Rule of Thirds -->
                            <Border x:Name="CropBoxBorder"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="2"
                                    Background="#15388BFD"
                                    Cursor="SizeAll"
                                    MouseDown="CropBox_MouseDown">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Fill="#33FFFFFF" Height="1" VerticalAlignment="Top" IsHitTestVisible="False"/>
                                    <Rectangle Grid.Row="2" Grid.ColumnSpan="3" Fill="#33FFFFFF" Height="1" VerticalAlignment="Top" IsHitTestVisible="False"/>
                                    <Rectangle Grid.Column="1" Grid.RowSpan="3" Fill="#33FFFFFF" Width="1" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                                    <Rectangle Grid.Column="2" Grid.RowSpan="3" Fill="#33FFFFFF" Width="1" HorizontalAlignment="Left" IsHitTestVisible="False"/>

                                    <!-- Dimension Badge -->
                                    <Border Background="#CC161B22" BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="1" CornerRadius="3" Padding="6,2"
                                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"
                                            IsHitTestVisible="False">
                                        <TextBlock x:Name="CropDimensionText" Text="1280 × 720 px"
                                                   Foreground="{DynamicResource TextBrush}" FontSize="10" FontWeight="SemiBold"
                                                   FontFamily="Consolas"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- 8 Interactive Resize Handles -->
                            <Border x:Name="HandleNW" Width="10" Height="10" Background="White" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="2" Cursor="SizeNWSE" MouseDown="Handle_MouseDown" Tag="NW"/>
                            <Border x:Name="HandleN"  Width="10" Height="10" Background="White" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="2" Cursor="SizeNS"   MouseDown="Handle_MouseDown" Tag="N"/>
                            <Border x:Name="HandleNE" Width="10" Height="10" Background="White" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="2" Cursor="SizeNESW" MouseDown="Handle_MouseDown" Tag="NE"/>
                            <Border x:Name="HandleE"  Width="10" Height="10" Background="White" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="2" Cursor="SizeWE"   MouseDown="Handle_MouseDown" Tag="E"/>
                            <Border x:Name="HandleSE" Width="10" Height="10" Background="White" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="2" Cursor="SizeNWSE" MouseDown="Handle_MouseDown" Tag="SE"/>
                            <Border x:Name="HandleS"  Width="10" Height="10" Background="White" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="2" Cursor="SizeNS"   MouseDown="Handle_MouseDown" Tag="S"/>
                            <Border x:Name="HandleSW" Width="10" Height="10" Background="White" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="2" Cursor="SizeNESW" MouseDown="Handle_MouseDown" Tag="SW"/>
                            <Border x:Name="HandleW"  Width="10" Height="10" Background="White" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="2" Cursor="SizeWE"   MouseDown="Handle_MouseDown" Tag="W"/>
                        </Canvas>

                        <!-- Playback Overlay Button -->
                        <Button x:Name="PlayPauseBtn"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="60" Height="60"
                                Style="{StaticResource GhostButton}"
                                FontSize="30" Content="▶"
                                Opacity="0.6" Visibility="Collapsed"
                                Click="TogglePlay_Click"
                                MouseEnter="PlayPauseBtn_MouseEnter"
                                MouseLeave="PlayPauseBtn_MouseLeave"/>

                        <!-- Live Transformation Badge on top left -->
                        <Border x:Name="LiveTransformBadge" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="10" Background="#99000000" CornerRadius="4" Padding="6,3"
                                Visibility="Collapsed">
                            <TextBlock x:Name="LiveTransformBadgeText" Text="LIVE PREVIEW"
                                       Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Seek bar -->
                <Grid x:Name="SeekPanel" Grid.Row="2" Margin="0,6,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SeekPlayBtn" Content="▶" Width="34" Height="28" Padding="0" FontSize="11"
                            Style="{StaticResource GhostButton}" Click="TogglePlay_Click"
                            VerticalAlignment="Center" ToolTip="Play / Pause (Space)"/>
                    <Slider x:Name="SeekSlider" Grid.Column="1" Margin="8,0"
                            Minimum="0" Maximum="100" Value="0"
                            VerticalAlignment="Center"
                            PreviewMouseLeftButtonDown="SeekSlider_MouseDown"
                            PreviewMouseLeftButtonUp="SeekSlider_MouseUp"
                            ValueChanged="SeekSlider_ValueChanged"/>
                    <TextBlock x:Name="SeekTimeText" Grid.Column="2" Text="00:00:00 / 00:00:00"
                               Foreground="{DynamicResource Text2Brush}" FontFamily="Consolas"
                               FontSize="11" VerticalAlignment="Center"/>
                </Grid>

                <!-- ── Filmstrip & Waveform Interactive Timeline ── -->
                <Border x:Name="TimelineTrackBorder" Grid.Row="3" Margin="0,6,0,0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Visibility="Collapsed" Padding="8,6">
                    <StackPanel>
                        <!-- Video track header + filmstrip canvas -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎬 Video" FontSize="11" Foreground="{DynamicResource Text2Brush}" FontFamily="Segoe UI"/>
                            </StackPanel>
                            <Border Grid.Column="1" Height="38" Background="{DynamicResource BgBrush}" CornerRadius="4" ClipToBounds="True"
                                    Cursor="Hand" MouseLeftButtonDown="Timeline_Click">
                                <Grid>
                                    <Canvas x:Name="FilmstripCanvas" SizeChanged="FilmstripCanvas_SizeChanged"/>
                                    <Rectangle x:Name="FilmstripPlayhead" Width="2" HorizontalAlignment="Left"
                                               Fill="{DynamicResource AccentBrush}" Opacity="0.9"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Audio track header + waveform canvas -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔊 Audio" FontSize="11" Foreground="{DynamicResource Text2Brush}" FontFamily="Segoe UI"/>
                            </StackPanel>
                            <Border Grid.Column="1" Height="24" Background="{DynamicResource BgBrush}" CornerRadius="4" ClipToBounds="True"
                                    Cursor="Hand" MouseLeftButtonDown="Timeline_Click">
                                <Grid>
                                    <Canvas x:Name="WaveformCanvas" SizeChanged="WaveformCanvas_SizeChanged"/>
                                    <Rectangle x:Name="WaveformPlayhead" Width="2" HorizontalAlignment="Left"
                                               Fill="{DynamicResource AccentBrush}" Opacity="0.9"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Edit summary badge -->
                <Border x:Name="EditSummaryBorder" Grid.Row="4" Margin="0,6,0,0" Visibility="Collapsed"
                        Background="{DynamicResource CardBrush}" CornerRadius="5" Padding="10,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Active Edits:" Foreground="{DynamicResource Text2Brush}" FontSize="11"
                                   FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock x:Name="EditSummaryText" Grid.Column="1" Text="No edits"
                                   Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"
                                   FontFamily="Segoe UI" Margin="6,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="2" Content="Reset All" Style="{StaticResource GhostButton}"
                                Padding="8,3" FontSize="10" Click="ResetAll_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ─────── RIGHT: TOOLS PANEL ─────── -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- ── Rotation & Flip ── -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="🔄 Rotation &amp; Flip (Live)" Foreground="{DynamicResource TextBrush}"
                                       FontWeight="SemiBold" FontSize="13" FontFamily="Segoe UI"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="Rotate90CWBtn" Content="90° CW" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="13,7" Click="Rotate90CW_Click"/>
                                <Button x:Name="Rotate90CCWBtn" Content="90° CCW" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="13,7" Click="Rotate90CCW_Click"/>
                                <Button x:Name="Rotate180Btn" Content="180°" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="13,7" Click="Rotate180_Click"/>
                                <Button x:Name="RotateResetBtn" Content="Reset" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="13,7" Click="ResetRotation_Click"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,2,0,0">
                                <Button x:Name="FlipHBtn" Content="↔ Flip Horizontal" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="14,7" Click="FlipH_Click"/>
                                <Button x:Name="FlipVBtn" Content="↕ Flip Vertical" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="14,7" Click="FlipV_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="RotationStatusText" Text="Current: 0° · No flip"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Audio Adjustments ── -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="🔊 Audio Adjustments (Live)" Foreground="{DynamicResource TextBrush}"
                                       FontWeight="SemiBold" FontSize="13" FontFamily="Segoe UI"/>
                            <TextBlock Text="Volume Boost / Attenuation" Foreground="{DynamicResource Text2Brush}" FontSize="11" Margin="0,8,0,4"/>
                            <WrapPanel>
                                <Button x:Name="VolDown6Btn" Content="-6 dB" Style="{StaticResource GhostButton}" Margin="0,0,5,6" Padding="11,6" Click="VolDown6_Click"/>
                                <Button x:Name="VolDown3Btn" Content="-3 dB" Style="{StaticResource GhostButton}" Margin="0,0,5,6" Padding="11,6" Click="VolDown3_Click"/>
                                <Button x:Name="VolUp3Btn" Content="+3 dB" Style="{StaticResource GhostButton}" Margin="0,0,5,6" Padding="11,6" Click="VolUp3_Click"/>
                                <Button x:Name="VolUp6Btn" Content="+6 dB" Style="{StaticResource GhostButton}" Margin="0,0,5,6" Padding="11,6" Click="VolUp6_Click"/>
                                <Button x:Name="ResetVolBtn" Content="Reset" Style="{StaticResource GhostButton}" Margin="0,0,5,6" Padding="11,6" Click="ResetVolume_Click"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,4,0,0">
                                <Button x:Name="MuteBtn" Content="🔇 Mute Audio" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="14,7" Click="MuteAudio_Click"/>
                                <Button x:Name="MonoBtn" Content="🎧 Stereo to Mono" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="14,7" Click="StereoToMono_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="AudioStatusText" Text="Volume: 0 dB · Stereo"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Aspect Ratio ── -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="📐 Aspect Ratio Preset" Foreground="{DynamicResource TextBrush}"
                                       FontWeight="SemiBold" FontSize="13" FontFamily="Segoe UI"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="AR16_9Btn" Content="16:9" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="14,7" Click="AR_16_9_Click"/>
                                <Button x:Name="AR9_16Btn" Content="9:16" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="14,7" Click="AR_9_16_Click" ToolTip="Vertical Mobile (Reels, TikTok, Shorts)"/>
                                <Button x:Name="AR4_3Btn" Content="4:3" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="14,7" Click="AR_4_3_Click"/>
                                <Button x:Name="AR1_1Btn" Content="1:1" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="14,7" Click="AR_1_1_Click" ToolTip="Square Post"/>
                                <Button x:Name="ARFlipBtn" Content="Flip Ratio" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="14,7" Click="FlipRatio_Click"/>
                                <Button x:Name="AROrigBtn" Content="Original" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="14,7" Click="AR_Original_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="AspectStatusText" Text="Current: Original"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Crop ── -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="✂️ Crop Tool" Foreground="{DynamicResource TextBrush}"
                                           FontWeight="SemiBold" FontSize="13" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ToggleButton x:Name="CropModeBoxBtn" Content="🎯 Edit Box"
                                                  Style="{StaticResource GhostToggleButton}"
                                                  Padding="8,3" FontSize="11" Margin="0,0,4,0"
                                                  Click="CropModeBox_Click" ToolTip="Show on-screen selection box with drag handles"/>
                                    <ToggleButton x:Name="CropModePreviewBtn" Content="👁️ Live Preview"
                                                  Style="{StaticResource GhostToggleButton}"
                                                  Padding="8,3" FontSize="11"
                                                  Click="CropModePreview_Click" ToolTip="Zoom player to preview the exact cropped video live"/>
                                </StackPanel>
                            </Grid>

                            <!-- Crop Aspect Ratio Presets -->
                            <TextBlock Text="Crop Presets" Foreground="{DynamicResource Text2Brush}" FontSize="11" Margin="0,10,0,4"/>
                            <WrapPanel>
                                <Button x:Name="CropPresetFreeBtn" Content="Freeform" Style="{StaticResource GhostButton}" Margin="0,0,5,5" Padding="10,5" Click="CropPresetFree_Click"/>
                                <Button x:Name="CropPreset16_9Btn" Content="16:9" Style="{StaticResource GhostButton}" Margin="0,0,5,5" Padding="10,5" Click="CropPreset16_9_Click" ToolTip="Widescreen Crop"/>
                                <Button x:Name="CropPreset9_16Btn" Content="9:16" Style="{StaticResource GhostButton}" Margin="0,0,5,5" Padding="10,5" Click="CropPreset9_16_Click" ToolTip="Vertical Shorts/Reels Crop"/>
                                <Button x:Name="CropPreset1_1Btn" Content="1:1" Style="{StaticResource GhostButton}" Margin="0,0,5,5" Padding="10,5" Click="CropPreset1_1_Click" ToolTip="Square Crop"/>
                                <Button x:Name="CropPreset4_3Btn" Content="4:3" Style="{StaticResource GhostButton}" Margin="0,0,5,5" Padding="10,5" Click="CropPreset4_3_Click"/>
                            </WrapPanel>

                            <!-- Pixel Coordinate Inputs -->
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="75"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Top" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" FontSize="11"/>
                                <TextBox x:Name="CropTopBox" Grid.Column="1" Text="0"
                                         Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                         Padding="5,3" FontSize="11" FontFamily="Consolas"
                                         LostFocus="CropBox_LostFocus" KeyDown="CropBox_KeyDown"/>
                                <TextBlock Grid.Column="3" Text="Bottom" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" FontSize="11"/>
                                <TextBox x:Name="CropBottomBox" Grid.Column="4" Text="0"
                                         Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                         Padding="5,3" FontSize="11" FontFamily="Consolas"
                                         LostFocus="CropBox_LostFocus" KeyDown="CropBox_KeyDown"/>
                                <TextBlock Grid.Row="2" Text="Left" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" FontSize="11"/>
                                <TextBox x:Name="CropLeftBox" Grid.Row="2" Grid.Column="1" Text="0"
                                         Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                         Padding="5,3" FontSize="11" FontFamily="Consolas"
                                         LostFocus="CropBox_LostFocus" KeyDown="CropBox_KeyDown"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="Right" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" FontSize="11"/>
                                <TextBox x:Name="CropRightBox" Grid.Row="2" Grid.Column="4" Text="0"
                                         Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                         Padding="5,3" FontSize="11" FontFamily="Consolas"
                                         LostFocus="CropBox_LostFocus" KeyDown="CropBox_KeyDown"/>
                            </Grid>
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="ApplyCropBtn" Content="✓ Apply &amp; Preview" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Padding="14,6" Click="ApplyCrop_Click"/>
                                <Button Content="Reset Crop" Style="{StaticResource GhostButton}" Padding="14,6" Click="ResetCrop_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="CropStatusText" Text="No crop applied · Full Frame"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ── FFmpeg Log (collapsible) ── -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="FFmpeg Log" Foreground="{DynamicResource TextBrush}"
                                           FontWeight="SemiBold" FontSize="13" FontFamily="Segoe UI"/>
                                <Button x:Name="ToggleLogBtn" Content="Show" HorizontalAlignment="Right"
                                        Style="{StaticResource GhostButton}" Padding="10,3" FontSize="10"
                                        Click="ToggleLog_Click"/>
                            </Grid>
                            <TextBox x:Name="LogBox" Margin="0,8,0,0" Height="120"
                                     Visibility="Collapsed"
                                     Background="{DynamicResource LogBgBrush}"
                                     Foreground="{DynamicResource LogTextBrush}"
                                     BorderThickness="0" FontFamily="Consolas" FontSize="11"
                                     AcceptsReturn="True" IsReadOnly="True"
                                     TextWrapping="NoWrap"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ════════════════ OUTPUT PANEL ════════════════ -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Format, Quality, GPU -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Format" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" FontSize="12"/>
                    <ComboBox x:Name="OutputFormatBox" Grid.Column="1" SelectedIndex="0"/>
                    <TextBlock Grid.Column="3" Text="Quality" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" FontSize="12"/>
                    <Slider x:Name="QualitySlider" Grid.Column="4" Minimum="10" Maximum="100" Value="70"
                            VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock x:Name="QualityText" Grid.Column="5" Text="70%" Foreground="{DynamicResource TextBrush}"
                               FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" MinWidth="35"/>
                    <CheckBox x:Name="GpuCheck" Grid.Column="7" Content="GPU Acceleration"
                              Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                              IsChecked="True"/>
                </Grid>

                <!-- Row 2: Output folder, Render buttons, Live telemetry -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/> <!-- Progress & Telemetry -->
                        <ColumnDefinition Width="Auto"/> <!-- Cancel button -->
                        <ColumnDefinition Width="Auto"/> <!-- Open Folder button -->
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/> <!-- Quick Save button -->
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/> <!-- Render button -->
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Output" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" FontSize="12"/>
                    <TextBlock x:Name="OutputPathText" Grid.Column="1" Text="Same as source file"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                               FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="2" Content="Browse" Style="{StaticResource GhostButton}" Padding="10,5" Click="BrowseOutput_Click"/>
                    <Button Grid.Column="3" Content="Reset" Style="{StaticResource GhostButton}" Padding="10,5" Margin="6,0,0,0" Click="ResetOutput_Click"/>

                    <!-- Render Progress & Telemetry (Column 5) -->
                    <Border x:Name="RenderProgressPanel" Grid.Column="5" Visibility="Collapsed"
                            Background="{DynamicResource CardBrush}" CornerRadius="5" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ProgressBar x:Name="RenderProgressBar" Width="140" Height="16"
                                         Minimum="0" Maximum="100" Margin="0,0,8,0"/>
                            <TextBlock x:Name="RenderProgressText" Text="0%"
                                       Foreground="{DynamicResource TextBrush}" FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="35"/>
                            <TextBlock x:Name="RenderTelemetryText" Text=""
                                       Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas" FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Cancel (Column 6) -->
                    <Button x:Name="CancelBtn" Grid.Column="6" Content="Cancel"
                            Style="{StaticResource DangerButton}" Padding="16,7" Margin="0,0,8,0"
                            Visibility="Collapsed" Click="Cancel_Click"/>

                    <!-- Open Folder (Column 7) -->
                    <Button x:Name="OpenFolderBtn" Grid.Column="7" Content="Open Folder"
                            Style="{StaticResource GhostButton}" Padding="14,7" Margin="0,0,8,0"
                            IsEnabled="False" Click="OpenFolder_Click" ToolTip="Open the output folder in Explorer"/>

                    <!-- Quick Save (Column 9) -->
                    <Button x:Name="QuickSaveBtn" Grid.Column="9" Content="Quick Save"
                            Style="{StaticResource GhostButton}" Padding="16,7" Click="QuickSave_Click"/>

                    <!-- Render (Column 11) -->
                    <Button x:Name="RenderBtn" Grid.Column="11" Content="Render"
                            Style="{StaticResource PrimaryButton}" Padding="24,7" Click="Render_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ════════════════ STATUS BAR ════════════════ -->
        <Grid Grid.Row="4" Background="{DynamicResource TitleBarBrush}" Margin="0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource MutedBrush}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource Text2Brush}"
                               VerticalAlignment="Center" Text="Ready" FontSize="11" FontFamily="Segoe UI"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Foreground="{DynamicResource MutedBrush}"
                           Text="Video Toolbox for VideoFixPro" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
