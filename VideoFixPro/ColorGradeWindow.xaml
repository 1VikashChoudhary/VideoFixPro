<Window x:Class="VideoFixPro.ColorGradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:VideoFixPro"
        Title="Color Grade &amp; Visual FX Studio"
        Width="1340" Height="860"
        MinWidth="1050" MinHeight="680"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{DynamicResource BgBrush}"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Icon="Assets/app_icon.png">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0,0,0,1" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>   <!-- 0: Title bar -->
            <RowDefinition Height="1"/>    <!-- 1: Separator -->
            <RowDefinition Height="*"/>    <!-- 2: Main workspace -->
            <RowDefinition Height="Auto"/> <!-- 3: Output bar -->
            <RowDefinition Height="30"/>   <!-- 4: Status bar -->
        </Grid.RowDefinitions>

        <!-- ════════════════ TITLE BAR ════════════════ -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBrush}"
              MouseLeftButtonDown="TitleBar_MouseDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                <Image Source="Assets/app_icon.png" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Color Grade &amp; Visual FX Studio" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           FontFamily="Segoe UI" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource CardBrush}" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleFileName" Text="No video loaded"
                               FontSize="10" Foreground="{DynamicResource Text2Brush}"
                               FontFamily="Segoe UI" MaxWidth="400"
                               TextTrimming="CharacterEllipsis"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="─" Style="{StaticResource TitleBarButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MinBtn_Click" ToolTip="Minimize"/>
                <Button x:Name="MaxBtn" Content="□" Style="{StaticResource TitleBarButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MaxBtn_Click" ToolTip="Maximize/Restore"/>
                <Button Content="✕" Style="{StaticResource TitleBarCloseButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseBtn_Click" ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <!-- Separator -->
        <Rectangle Grid.Row="1" Fill="{DynamicResource BorderBrush}"/>

        <!-- ════════════════ MAIN WORKSPACE ════════════════ -->
        <Grid Grid.Row="2" Margin="14,12,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.2*" MinWidth="420"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="2.2*" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <!-- ─────── LEFT: PREVIEW & SPLIT-VIEW PANEL ─────── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- File header / Drop zone -->
                    <RowDefinition Height="*"/>     <!-- Video Player -->
                    <RowDefinition Height="Auto"/>  <!-- Seek bar & Playback controls -->
                    <RowDefinition Height="Auto"/>  <!-- Active Grade Summary bar -->
                </Grid.RowDefinitions>

                <!-- Drop Zone (visible when empty) -->
                <Border x:Name="DropZone" Grid.Row="0" Grid.RowSpan="4"
                        BorderBrush="{DynamicResource MutedBrush}"
                        BorderThickness="2" CornerRadius="8"
                        Background="{DynamicResource SurfaceBrush}"
                        Cursor="Hand"
                        MouseLeftButtonDown="DropZone_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🎨" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Color Grade &amp; Visual FX Studio" FontSize="20" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock Text="Drop a video here to start color grading &amp; applying cinematic filters"
                                   Foreground="{DynamicResource Text2Brush}" FontFamily="Segoe UI" FontSize="13"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="or click to browse  ·  MP4, MKV, MOV, WebM, AVI, FLV"
                                   Foreground="{DynamicResource MutedBrush}" FontFamily="Segoe UI" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- File Header (visible after load) -->
                <Border x:Name="FileHeader" Grid.Row="0" Visibility="Collapsed"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderFileName" Text="video.mp4"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock x:Name="HeaderDuration" Text="00:00:00" Foreground="{DynamicResource Text2Brush}" FontFamily="Segoe UI" FontSize="11"/>
                                </Border>
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock x:Name="HeaderResolution" Text="1920x1080" Foreground="{DynamicResource Text2Brush}" FontFamily="Segoe UI" FontSize="11"/>
                                </Border>
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="3" Padding="6,2">
                                    <TextBlock x:Name="HeaderCodec" Text="H.264" Foreground="{DynamicResource Text2Brush}" FontFamily="Segoe UI" FontSize="11"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Change Video" Style="{StaticResource GhostButton}" Padding="10,5" Click="ChangeFile_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Video Player Container -->
                <Border x:Name="PlayerBorder" Grid.Row="1" Margin="0,8,0,0"
                        Background="Black" CornerRadius="8" ClipToBounds="True"
                        Visibility="Collapsed"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <!-- GPU-Accelerated Color Graded Video Viewport -->
                        <Grid x:Name="VideoViewport">
                            <Viewbox x:Name="PlayerViewbox" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid x:Name="PlayerRotator">
                                    <!-- Media Player Element -->
                                    <MediaElement x:Name="Player"
                                                  LoadedBehavior="Manual"
                                                  UnloadedBehavior="Stop"
                                                  ScrubbingEnabled="True"
                                                  Volume="0.5"
                                                  Stretch="Fill"
                                                  MediaOpened="Player_MediaOpened"
                                                  MediaEnded="Player_MediaEnded"/>

                                    <!-- High-Fidelity Snapshot Image (Active for 3D LUT preview and fine detail) -->
                                    <Image x:Name="GradedFramePreview" Stretch="Fill" Visibility="Collapsed" IsHitTestVisible="False"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Viewbox>
                        </Grid>

                        <!-- Center Play/Pause Overlay Button -->
                        <Button x:Name="PlayPauseBtn"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="54" Height="54"
                                Style="{StaticResource GhostButton}"
                                FontSize="24" Content="▶"
                                Opacity="0.75" Visibility="Collapsed"
                                Click="TogglePlay_Click"/>

                        <!-- Comparison Mode Badge -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                                Background="#E0161B22" CornerRadius="4" Padding="8,3"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="PreviewBadgeText" Text="✨ Real-Time GPU Color Grading"
                                       Foreground="{DynamicResource AccentBrush}" FontSize="10.5" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Seek Bar & Playback Controls -->
                <Grid x:Name="SeekPanel" Grid.Row="2" Margin="0,8,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SeekPlayBtn" Content="▶" Width="34" Height="28"
                            Style="{StaticResource GhostButton}" Click="TogglePlay_Click"
                            VerticalAlignment="Center" Padding="0" FontSize="11"/>
                    <Slider x:Name="SeekSlider" Grid.Column="1" Margin="8,0"
                            Minimum="0" Maximum="100" Value="0"
                            VerticalAlignment="Center"
                            PreviewMouseLeftButtonDown="SeekSlider_MouseDown"
                            PreviewMouseLeftButtonUp="SeekSlider_MouseUp"
                            ValueChanged="SeekSlider_ValueChanged"/>
                    <TextBlock x:Name="SeekTimeText" Grid.Column="2" Text="00:00:00 / 00:00:00"
                               Foreground="{DynamicResource Text2Brush}" FontFamily="Consolas"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="CompareBtn" Grid.Column="3" Content="👁️ Hold Original"
                            Style="{StaticResource GhostButton}" Padding="8,4" FontSize="10"
                            PreviewMouseDown="CompareBtn_MouseDown"
                            PreviewMouseUp="CompareBtn_MouseUp"
                            ToolTip="Click and hold to compare with unedited original footage"/>
                    <Button x:Name="ResetBtn" Grid.Column="5" Content="↺ Reset"
                            Style="{StaticResource GhostButton}" Padding="8,4" FontSize="10"
                            Click="ResetAll_Click" ToolTip="Reset all sliders to flat original"/>
                </Grid>

                <!-- Active Filter Summary Card -->
                <Border x:Name="FilterSummaryBorder" Grid.Row="3" Margin="0,6,0,0" Visibility="Collapsed"
                        Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="10,6"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Active Grade:" Foreground="{DynamicResource Text2Brush}" FontSize="11"
                                   FontFamily="Segoe UI" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ActiveFilterSummaryText" Grid.Column="1" Text="Original (No adjustments)"
                                   Foreground="{DynamicResource AccentBrush}" FontSize="11"
                                   FontFamily="Segoe UI" Margin="8,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="2" Content="Reset All ↺" Style="{StaticResource GhostButton}"
                                Padding="8,2" FontSize="10" Click="ResetAll_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ─────── RIGHT: COLOR CONTROLS & PRESET SUITE ─────── -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- ── 1. CINEMATIC FILTER PRESETS ── -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🎬" FontSize="13" Margin="0,0,6,0"/>
                                    <TextBlock Text="Cinematic Look Presets" Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold" FontSize="12.5" FontFamily="Segoe UI"/>
                                </StackPanel>
                                <TextBlock Text="1-Click Apply" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="10.5" VerticalAlignment="Center"/>
                            </Grid>

                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="PresetOriginal" Content="Original" Style="{StaticResource ActiveToolButton}" Margin="0,0,6,6" Padding="12,6" Click="PresetOriginal_Click"/>
                                <Button x:Name="PresetTealOrange" Content="🎬 Teal &amp; Orange" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="12,6" Click="PresetTealOrange_Click"/>
                                <Button x:Name="PresetGoldenHour" Content="☀️ Golden Hour" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="12,6" Click="PresetGoldenHour_Click"/>
                                <Button x:Name="PresetFilm35" Content="🎥 35mm Vintage" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="12,6" Click="PresetFilm35_Click"/>
                                <Button x:Name="PresetNoirBW" Content="🖤 Noir B&amp;W" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="12,6" Click="PresetNoirBW_Click"/>
                                <Button x:Name="PresetVividHDR" Content="💎 Vivid HDR Pop" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="12,6" Click="PresetVividHDR_Click"/>
                                <Button x:Name="PresetNordicCold" Content="❄️ Cold Nordic" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="12,6" Click="PresetNordicCold_Click"/>
                                <Button x:Name="PresetPastel" Content="🌸 Pastel Dream" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="12,6" Click="PresetPastel_Click"/>
                                <Button x:Name="PresetEmerald" Content="🌲 Emerald Cine" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="12,6" Click="PresetEmerald_Click"/>
                                <Button x:Name="PresetSepia" Content="📜 Warm Sepia" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Padding="12,6" Click="PresetSepia_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── 2. LIGHT & EXPOSURE ── -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="☀️" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="Light &amp; Exposure" Foreground="{DynamicResource TextBrush}"
                                           FontWeight="SemiBold" FontSize="12.5" FontFamily="Segoe UI"/>
                            </StackPanel>

                            <!-- Brightness -->
                            <Grid Margin="0,10,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="45"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Brightness" Foreground="{DynamicResource Text2Brush}" FontSize="11" VerticalAlignment="Center"/>
                                <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="-100" Maximum="100" Value="0"
                                        VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                                <TextBlock x:Name="BrightnessText" Grid.Column="2" Text="0%" Foreground="{DynamicResource TextBrush}"
                                           FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Contrast -->
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="45"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Contrast" Foreground="{DynamicResource Text2Brush}" FontSize="11" VerticalAlignment="Center"/>
                                <Slider x:Name="ContrastSlider" Grid.Column="1" Minimum="0" Maximum="250" Value="100"
                                        VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                                <TextBlock x:Name="ContrastText" Grid.Column="2" Text="100%" Foreground="{DynamicResource TextBrush}"
                                           FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Gamma -->
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="45"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Gamma" Foreground="{DynamicResource Text2Brush}" FontSize="11" VerticalAlignment="Center"/>
                                <Slider x:Name="GammaSlider" Grid.Column="1" Minimum="20" Maximum="250" Value="100"
                                        VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                                <TextBlock x:Name="GammaText" Grid.Column="2" Text="1.00" Foreground="{DynamicResource TextBrush}"
                                           FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Cinematic LUT (.cube) -->
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="LUT (.cube)" Foreground="{DynamicResource Text2Brush}" FontSize="11" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="{DynamicResource CardBrush}" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,6,0">
                                    <TextBlock x:Name="LutPathText" Text="No LUT selected" Foreground="{DynamicResource Text2Brush}" FontSize="11" VerticalAlignment="Center" Padding="6,4" TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <Button Grid.Column="2" Content="Browse" Style="{StaticResource GhostButton}" Padding="8,4" FontSize="10" Click="BrowseLut_Click" Margin="0,0,4,0"/>
                                <Button Grid.Column="3" Content="Clear" Style="{StaticResource GhostButton}" Padding="8,4" FontSize="10" Click="ClearLut_Click"/>
                            </Grid>
                            
                            <!-- Clarity / Sharpness -->
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="45"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Sharpness" Foreground="{DynamicResource Text2Brush}" FontSize="11" VerticalAlignment="Center"/>
                                <Slider x:Name="SharpnessSlider" Grid.Column="1" Minimum="0" Maximum="200" Value="0"
                                        VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                                <TextBlock x:Name="SharpnessText" Grid.Column="2" Text="0.0" Foreground="{DynamicResource TextBrush}"
                                           FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── 3. COLOR & TONE ── -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌈" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="Color &amp; Temperature" Foreground="{DynamicResource TextBrush}"
                                           FontWeight="SemiBold" FontSize="12.5" FontFamily="Segoe UI"/>
                            </StackPanel>

                            <!-- Saturation -->
                            <Grid Margin="0,10,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="45"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Saturation" Foreground="{DynamicResource Text2Brush}" FontSize="11" VerticalAlignment="Center"/>
                                <Slider x:Name="SaturationSlider" Grid.Column="1" Minimum="0" Maximum="250" Value="100"
                                        VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                                <TextBlock x:Name="SaturationText" Grid.Column="2" Text="100%" Foreground="{DynamicResource TextBrush}"
                                           FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Temperature (Cool - Warm) -->
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="45"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Warmth" Foreground="{DynamicResource Text2Brush}" FontSize="11" VerticalAlignment="Center"/>
                                <Slider x:Name="TemperatureSlider" Grid.Column="1" Minimum="-100" Maximum="100" Value="0"
                                        VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                                <TextBlock x:Name="TemperatureText" Grid.Column="2" Text="0" Foreground="{DynamicResource TextBrush}"
                                           FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Tint (Green - Magenta) -->
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="45"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tint" Foreground="{DynamicResource Text2Brush}" FontSize="11" VerticalAlignment="Center"/>
                                <Slider x:Name="TintSlider" Grid.Column="1" Minimum="-100" Maximum="100" Value="0"
                                        VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                                <TextBlock x:Name="TintText" Grid.Column="2" Text="0" Foreground="{DynamicResource TextBrush}"
                                           FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── 4. ATMOSPHERE & VIGNETTE ── -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌌" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="Atmosphere &amp; Vignette" Foreground="{DynamicResource TextBrush}"
                                           FontWeight="SemiBold" FontSize="12.5" FontFamily="Segoe UI"/>
                            </StackPanel>

                            <!-- Vignette -->
                            <Grid Margin="0,10,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="45"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Vignette" Foreground="{DynamicResource Text2Brush}" FontSize="11" VerticalAlignment="Center"/>
                                <Slider x:Name="VignetteSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="0"
                                        VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                                <TextBlock x:Name="VignetteText" Grid.Column="2" Text="0%" Foreground="{DynamicResource TextBrush}"
                                           FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── 5. FFMPEG LOG (COLLAPSIBLE) ── -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="FFmpeg Command &amp; Log" Foreground="{DynamicResource TextBrush}"
                                           FontWeight="SemiBold" FontSize="12.5" FontFamily="Segoe UI"/>
                                <Button x:Name="ToggleLogBtn" Content="Show" HorizontalAlignment="Right"
                                        Style="{StaticResource GhostButton}" Padding="8,2" FontSize="10"
                                        Click="ToggleLog_Click"/>
                            </Grid>
                            <TextBox x:Name="LogBox" Margin="0,8,0,0" Height="110"
                                     Visibility="Collapsed"
                                     Background="{DynamicResource LogBgBrush}"
                                     Foreground="{DynamicResource LogTextBrush}"
                                     BorderThickness="0" FontFamily="Consolas" FontSize="11"
                                     AcceptsReturn="True" IsReadOnly="True"
                                     TextWrapping="NoWrap"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ════════════════ OUTPUT & RENDER PANEL ════════════════ -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Format, Quality, GPU -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Format" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" FontSize="12"/>
                    <ComboBox x:Name="OutputFormatBox" Grid.Column="1" SelectedIndex="0">
                        <ComboBoxItem Content="MP4 (.mp4)"/>
                        <ComboBoxItem Content="MP4 (AV1)"/>
                        <ComboBoxItem Content="MKV (.mkv)"/>
                        <ComboBoxItem Content="MOV (.mov)"/>
                        <ComboBoxItem Content="WebM (.webm)"/>
                    </ComboBox>
                    <TextBlock Grid.Column="3" Text="Quality" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" FontSize="12"/>
                    <Slider x:Name="QualitySlider" Grid.Column="4" Minimum="10" Maximum="100" Value="75"
                            VerticalAlignment="Center" Margin="8,0" ValueChanged="QualitySlider_ValueChanged"/>
                    <TextBlock x:Name="QualityText" Grid.Column="5" Text="75%" Foreground="{DynamicResource TextBrush}"
                               FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" MinWidth="35"/>
                    <CheckBox x:Name="GpuCheck" Grid.Column="7" Content="GPU Hardware Acceleration"
                              Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                              IsChecked="True"/>
                </Grid>

                <!-- Row 2: Output folder, Progress, Render Buttons -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Output" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" FontSize="12"/>
                    <TextBlock x:Name="OutputPathText" Grid.Column="1" Text="Same as source file"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                               FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="2" Content="Browse" Style="{StaticResource GhostButton}" Padding="10,5" Click="BrowseOutput_Click"/>
                    <Button Grid.Column="3" Content="Reset" Style="{StaticResource GhostButton}" Padding="10,5" Margin="6,0,0,0" Click="ResetOutput_Click"/>

                    <!-- Progress Bar Container (Column 5) -->
                    <Grid Grid.Column="5" VerticalAlignment="Center">
                        <ProgressBar x:Name="RenderProgressBar" Width="150" Height="22"
                                     Minimum="0" Maximum="100" Visibility="Collapsed"/>
                        <TextBlock x:Name="RenderProgressText" Text="0%"
                                   Foreground="{DynamicResource TextBrush}" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>

                    <!-- Cancel (Column 7) -->
                    <Button x:Name="CancelBtn" Grid.Column="7" Content="Cancel"
                            Style="{StaticResource DangerButton}" Padding="16,7"
                            Visibility="Collapsed" Click="Cancel_Click"/>
                    
                    <!-- Open Folder (Column 9) -->
                    <Button x:Name="OpenFolderBtn" Grid.Column="9" Content="Open Folder"
                            Style="{StaticResource GhostButton}" Padding="14,7"
                            IsEnabled="False" Click="OpenFolder_Click" ToolTip="Open output folder in Explorer"/>

                    <!-- Export Button (Column 11) -->
                    <Button x:Name="ApplyGradeBtn" Grid.Column="11" Content="Export Graded Video 🎨"
                            Style="{StaticResource PrimaryButton}" Padding="22,7" Click="ApplyGrade_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ════════════════ STATUS BAR ════════════════ -->
        <Grid Grid.Row="4" Background="{DynamicResource TitleBarBrush}">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource MutedBrush}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource Text2Brush}"
                               VerticalAlignment="Center" Text="Ready. Drop a video file to begin color grading." FontSize="11" FontFamily="Segoe UI"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Foreground="{DynamicResource MutedBrush}"
                           Text="Color Grade &amp; Visual FX Studio · VideoFixPro" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
